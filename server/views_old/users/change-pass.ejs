<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

  <% if(message) { %>
    <div class="container">
      <div class="alert alert-success w-50" id="myAlert" role="alert">
        <%= message  %>
      </div>  
    </div>
  <% } %>

  <div class="card shadow-sm mt-0">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center text-white">Changement du mot de passe</h4>
    </div>

    <div class="card-body">
      <!-- Formulaire de création/modification -->
      <form id="userForm" action="/users/valide-change-password" method="POST" class="row g-2 align-items-end">
        <input type="hidden" name="id" id="userId" value="">

        <div id="formStatus" class="col-12"></div>

        <div class="col-md-2">
          <label for="nom" class="form-label">Entrer le nouveau mot de passe</label>
          <input type="password" class="form-control" id="nom" name="newpass" required>
        </div>

        <div class="col-md-2">
          <label for="password" class="form-label">Retaper le nouveau mot de passe</label>
          <input type="password" class="form-control" id="telephone" name="newpassr">
        </div>
 
      

        <div class="col-md-4 d-flex justify-content-end gap-2">
          <button type="submit" id="submitBtn" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> <span id="submitText">Modifier</span>
          </button>

          
        </div>
      </form>
    </div>
  </div>

  
</div>

<!-- JS INTERACTIF -->
<script>
  const userForm = document.getElementById('userForm');
  const userIdInput = document.getElementById('userId');
  const nomInput = document.getElementById('nom');
  const telephoneInput = document.getElementById('telephone');
  const loginInput = document.getElementById('login');
  const profilSelect = document.getElementById('profil');
  const submitText = document.getElementById('submitText');
  const cancelBtn = document.getElementById('cancelBtn');
  const formStatus = document.getElementById('formStatus');
  const userListContainer = document.getElementById('userListContainer');

  function editUser(user) {
    userIdInput.value = user.id;
    nomInput.value = user.nom;
    telephoneInput.value = user.telephone || '';
    loginInput.value = user.login;
    profilSelect.value = user.profil;

    loginInput.setAttribute('readonly', true); // Griser le champ login
    loginInput.classList.add('bg-light');      // Style visuel

    submitText.textContent = 'Modifier';
    formStatus.innerHTML = `
      <div class="alert alert-warning py-1 px-3 mb-3">
        <i class="bi bi-pencil-square"></i> Mode <strong>modification</strong> activé pour l'utilisateur : <strong>${user.nom}</strong>
      </div>
    `;

    userListContainer.style.display = 'none';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  cancelBtn.addEventListener('click', () => {
    userForm.reset();
    userIdInput.value = '';
    loginInput.removeAttribute('readonly');
    loginInput.classList.remove('bg-light');

    submitText.textContent = 'Ajouter';
    formStatus.innerHTML = '';
    userListContainer.style.display = '';
  });
</script>

<!-- Flash auto-hide -->
<script>
  function vanish() {
    const alert = document.getElementById('myAlert');
    if (alert) alert.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(vanish, 3000);
  });
</script>

<%- include('../partials/footer') %>
