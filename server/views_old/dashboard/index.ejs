<%- include('../partials/header') %>

<div class="container-fluid mt-4 mb-5">

  <!-- --- Message flash --- -->
  <% if (message) { %>
    <div class="alert alert-<%= message.type || 'info' %> alert-dismissible fade show" role="alert">
      <%= message.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- --- Cards statistiques --- -->
  <div class="row g-3">
    <% const stats = [
      { title: 'Clients', value: totalClients || 0, icon: 'bi-people-fill', color: 'secondary' },
      { title: 'Ventes (Mois)', value: totalVentesMois || 0, icon: 'bi-bag-fill', color: totalVentesMois > 0 ? 'success' : 'dark' },
      { title: 'Salaires (Mois)', value: depenseTotale || 0, icon: 'bi-cash-stack', color: depenseTotale > 0 ? 'warning' : 'dark' },
      { title: 'Personnels', value: totalPersonnels || 0, icon: 'bi-person-badge-fill', color: 'danger' },
    ]; %>

    <% stats.forEach(stat => { %>
      <div class="col-md-3">
        <div class="card text-white bg-<%= stat.color %> shadow-sm">
          <div class="card-body d-flex justify-content-between align-items-center">
            <div>
              <h5 class="card-title"><%= stat.title %></h5>
              <h3><%= stat.value.toLocaleString() %> <%= stat.title.includes('Ventes') || stat.title.includes('Salaires') ? 'FCFA' : '' %></h3>
            </div>
            <i class="bi <%= stat.icon %> fs-2"></i>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- --- Top 5 ventes --- -->
  <div class="row mt-4">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0">Top 5 ventes ce mois</h5>
        </div>
        <div class="card-body">
          <% if(topVentes && topVentes.length > 0){ %>
            <ul class="list-group list-group-flush">
              <% topVentes.forEach((vente, index) => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <span><%= index + 1 %>. <%= vente.Client.nom %> <%= vente.Client.prenom %></span>
                  <span class="badge rounded-pill <%= vente.montant > 0 ? 'bg-success' : 'bg-secondary' %>">
                    <%= vente.montant.toLocaleString() %> FCFA
                  </span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-muted">Aucune vente ce mois.</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- --- Graphique ventes par mois --- -->
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0">Ventes par mois</h5>
        </div>
        <div class="card-body">
          <canvas id="ventesChart" height="200"></canvas>
        </div>
      </div>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctx = document.getElementById('ventesChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'],
      datasets: [{
        label: 'Montant des ventes (FCFA)',
        data: <%- JSON.stringify(ventesParMois) %>,
        backgroundColor: 'rgba(54, 162, 235, 0.2)',
        borderColor: 'rgba(54, 162, 235, 1)',
        borderWidth: 2,
        fill: true,
        tension: 0.4,
        pointRadius: 4,
        pointBackgroundColor: 'rgba(54, 162, 235, 1)',
        pointBorderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: true },
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.dataset.label + ': ' + context.parsed.y.toLocaleString() + ' FCFA';
            }
          }
        }
      },
      scales: {
        y: { beginAtZero: true },
        x: { ticks: { autoSkip: false } }
      }
    }
  });
</script>

<%- include('../partials/footer') %>
