<%- include('../partials/header', { pageTitle: pageTitle }) %>

<button class="btn btn-secondary" onclick="imprimerToutesLesVentes()">
        <i class="bi bi-printer"></i> Imprimer les détails
      </button> 
<div class="container mt-5"  id="venteTable">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><%= pageTitle %></h1>
    <a href="/ventes/index" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Retour aux ventes
    </a>
  </div>

  <% if (ventes.length === 0) { %>
    <div class="alert alert-info">Aucun versement trouvé pour ce client.</div>
  <% } else { %>
    <% ventes.forEach(vente => { 
         const montantTotal = vente.quantite * vente.prix_unitaire;
    %>
      <div class="card mb-4 shadow-sm" >
        <div class="card-header bg-primary text-white">
          Vente n° <strong><%= vente.id %>-- <%= cl.nom %>--  <%= cl.prenom %></strong> — Montant total :
          <strong><%= new Intl.NumberFormat('fr-FR').format(montantTotal.toFixed(2)) %> FCFA</strong> 
        </div>

        <div class="card-body">
          <% if (!vente.Paiements || vente.Paiements.length === 0) { %>
            <p class="text-muted">Aucun versement pour cette vente.</p>
          <% } else { %>

            <!--  Tableau avec colonne "Observation" ajoutée -->
            <div style="max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 5px;">
              <table class="table table-sm table-striped mb-0">
                <thead class="table-light sticky-top">
                  <tr>
                    <th>Date</th>
                    <th>Montant</th>
                    <th>Observation</th> 
                  </tr>
                </thead>
                <tbody>
                  <% vente.Paiements.forEach(p => { %>
                    <tr>
                      <td><%= new Date(p.date).toLocaleDateString('fr-FR') %></td>
                      <td><%= new Intl.NumberFormat('fr-FR').format(p.montant.toFixed(2)) %> FCFA</td>
                      <td><%= p.observation ? p.observation : "<em>Aucune</em>" %></td> 
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <!-- Fin conteneur scrollable -->

          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


