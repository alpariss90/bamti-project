<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">
  <div class="card shadow-sm mt-4">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Gestion des Dépenses</h4>
    </div>

    <div class="card-body">
      <!-- Formulaire -->
      <form id="depenseForm" action="/depenses/createOrUpdate" method="POST" class="row g-2 align-items-end">
        <input type="hidden" name="id" id="depenseId">
        <div id="formStatus" class="col-12"></div>

        <div class="col-md-3">
          <label for="id_type_depense" class="form-label">Type de dépense</label>
          <select name="id_type_depense" id="id_type_depense" class="form-select" required>
            <option value="">-- Sélectionner --</option>
            <% types.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.libelle %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-3">
          <label for="id_engin" class="form-label">Engin (optionnel)</label>
          <select name="id_engin" id="id_engin" class="form-select">
            <option value="">-- Aucun --</option>
            <% engins.forEach(e => { %>
              <option value="<%= e.id %>"><%= e.libelle %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-2">
          <label for="date_depense" class="form-label">Date</label>
          <input type="date" name="date_depense" id="date_depense" class="form-control" required>
        </div>

        <div class="col-md-2">
          <label for="montant_depense" class="form-label">Montant (F)</label>
          <input type="number" step="0.01" name="montant_depense" id="montant_depense" class="form-control" required>
        </div>

        <div class="col-md-2">
          <label for="observation" class="form-label">Observation</label>
          <input type="text" name="observation" id="observation" class="form-control">
        </div>

        <div class="col-md-12 d-flex justify-content-end gap-2 mt-2">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> <span id="submitText">Ajouter</span>
          </button>
          <a href="/depenses/filtre" class="btn btn-secondary">
            <i class="bi bi-funnel"></i> Filtrer
          </a>
        </div>
      </form>
    </div>
  </div>

  <% if (message) { %>
  <div class="container-fluid p-0">
    <div class="alert alert-<%= message.type %> w-75 mb-0" id="myAlert" role="alert">
      <%= message.text %>
    </div>
  </div>
  <% } %>

  <!-- Liste -->
  <div id="depenseListContainer" class="mt-4">
    <h5 class="mb-3 fw-bold">Liste des Dépenses</h5>

    <% if (depenses && depenses.length > 0) { %>
      <div class="d-flex justify-content-end mb-2">
        <input type="text" id="filterDepInput" class="form-control form-control-sm w-auto" placeholder="Filtrer...">
      </div>

      <div class="table-responsive shadow-sm rounded" style="height: 70vh; overflow-y: auto; border: 1px solid #dee2e6;">
        <table class="table table-hover align-middle table-bordered">
          <thead class="table-secondary">
            <tr>
              <th>#</th>
              <th>Type</th>
              <th>Engin</th>
              <th>Date</th>
              <th>Montant</th>
              <th>Observation</th>
              <th>Statut</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% depenses.forEach((d, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= d.typeDepense?.libelle %></td>
                <td><%= d.engin?.libelle || '-' %></td>
                <td><%= d.date_depense.toISOString().split('T')[0] %></td>
                <td><%= new Intl.NumberFormat('fr-FR').format(Number(d.montant_depense || 0).toFixed(2)) %> FCFA</td>
                <td><%= d.observation || '-' %></td>
                <td>
                  <% if (d.isValid) { %>
                    <span class="badge bg-success">Validée</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">En attente</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (!d.isValid) { %>
                    <div class="dropdown">
                      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        Actions
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                          <a href="#" class="dropdown-item text-warning" onclick='editDepense(<%- JSON.stringify(d) %>)'>
                            <i class="bi bi-pencil"></i> Modifier
                          </a>
                        </li>
                        <li>
                          <button class="dropdown-item text-danger" type="button" onclick="showSnackbar(<%= d.id %>, '<%= d.typeDepense?.libelle %>')">
                            <i class="bi bi-trash"></i> Supprimer
                          </button>
                        </li>
                        <li>
                          <form action="/depenses/validate/<%= d.id %>" method="POST" class="d-inline">
                            <button type="submit" class="dropdown-item text-success">
                              <i class="bi bi-check2-circle"></i> Valider
                            </button>
                          </form>
                        </li>
                      </ul>
                    </div>
                  <% } else { %>
                    <span class="text-success fw-bold"><i class="bi bi-check-circle"></i> Validée</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info">Aucune dépense enregistrée.</div>
    <% } %>
  </div>
</div>

<!-- Snackbar -->
<div id="snackbar" class="snackbar shadow">
  <span id="snackbar-message">Confirmer la suppression ?</span>
  <form id="snackbarForm" method="POST" class="d-inline">
    <button type="submit" class="btn btn-danger btn-sm ms-3">Oui, supprimer</button>
    <button type="button" class="btn btn-secondary btn-sm ms-1" onclick="hideSnackbar()">Annuler</button>
  </form>
</div>

<style>
  .snackbar {
    visibility: hidden;
    background-color: #333;
    color: #fff;
    border-radius: 8px;
    padding: 16px;
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  .snackbar.show { visibility: visible; opacity: 1; }
</style>

<script>
  const depenseForm = document.getElementById('depenseForm');
  const depenseId = document.getElementById('depenseId');
  const submitText = document.getElementById('submitText');
  const cancelBtn = document.getElementById('cancelBtn');
  const formStatus = document.getElementById('formStatus');
  const depenseListContainer = document.getElementById('depenseListContainer');

  // Remplir le formulaire pour modification
  function editDepense(dep) {
    depenseId.value = dep.id;
    document.getElementById('id_type_depense').value = dep.id_type_depense;
    document.getElementById('id_engin').value = dep.id_engin || '';
    document.getElementById('date_depense').value = dep.date_depense.split('T')[0];
    document.getElementById('montant_depense').value = Number(dep.montant_depense || 0).toFixed(2);
    document.getElementById('observation').value = dep.observation || '';

    submitText.textContent = 'Modifier';
    formStatus.innerHTML = `
      <div class="alert alert-warning py-1 px-3 mb-3">
        <i class="bi bi-pencil-square"></i> Mode <strong>modification</strong> activé pour : 
        <strong>${dep.typeDepense?.libelle}</strong>
      </div>`;
    depenseListContainer.style.display = 'none';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Annuler modification
  cancelBtn.addEventListener('click', () => {
    depenseForm.reset();
    depenseId.value = '';
    submitText.textContent = 'Ajouter';
    formStatus.innerHTML = '';
    depenseListContainer.style.display = '';
  });

  // Snackbar suppression
  const snackbar = document.getElementById('snackbar');
  const snackbarMessage = document.getElementById('snackbar-message');
  const snackbarForm = document.getElementById('snackbarForm');

  function showSnackbar(id, type) {
    snackbarMessage.innerHTML = `Supprimer la dépense de "<strong>${type}</strong>" ?`;
    snackbarForm.action = `/depenses/delete/${id}`;
    snackbar.classList.add('show');
  }
  function hideSnackbar() { snackbar.classList.remove('show'); }

  // Filtre de la liste
  document.addEventListener('DOMContentLoaded', () => {
    const alert = document.getElementById('myAlert');
    if (alert) setTimeout(() => alert.style.display = 'none', 3000);

    const filterInput = document.getElementById('filterDepInput');
    const rows = document.querySelectorAll('#depenseListContainer tbody tr');

    if (filterInput) {
      filterInput.addEventListener('input', () => {
        const val = filterInput.value.toLowerCase();
        rows.forEach(r => {
          r.style.display = r.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
      });
    }
  });
</script>

<%- include('../partials/footer') %>
