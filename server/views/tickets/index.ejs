<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

  <div class="card shadow-sm mt-4">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Gestion des Tickets</h4>
    </div>

    <div class="card-body">
      <% if (peut('tickets.gerer')) { %>
      <!-- Formulaire -->
      <form id="ticketForm" action="/tickets/createOrUpdate" method="POST" class="row g-2 align-items-end">
        <input type="hidden" name="id" id="ticketId">

        <div id="formStatus" class="col-12"></div>

        <div class="col-md-3">
          <label for="id_client" class="form-label">Client</label>
          <select class="form-control select2-client" id="id_client" name="id_client" required>
            <option value="">-- Sélectionner un client --</option>
            <% if (clients) { %>
              <% clients.forEach(client => { %>
                <option value="<%= client.id %>"><%= client.nom %> <%= client.prenom %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="col-md-2">
          <label for="quantite" class="form-label">Quantité</label>
          <input type="number" class="form-control" id="quantite" name="quantite" min="1" value="1" required>
        </div>

        <div class="col-md-2">
          <label for="nom_chauffeur" class="form-label">Nom chauffeur</label>
          <input type="text" class="form-control" id="nom_chauffeur" name="nom_chauffeur"  required>
        </div>


        <div class="col-md-2">
          <label for="marque_voiture" class="form-label">Marque voiture</label>
          <input type="text" class="form-control" id="marque_voiture" name="marque_voiture"  required>
        </div>
     <!--   
        <div class="col-md-2">
          <label for="statut" class="form-label">Statut</label>
          <select class="form-control" id="statut" name="statut" required>
            <option value="en attente">En attente</option>
            <option value="livrée">Livrée</option>
            <option value="annulée">Annulée</option>
          </select>
        </div>
        -->
        <div class="col-md-3 d-flex justify-content-end gap-2">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> <span id="submitText">Ajouter</span>
          </button>
          <button type="button" id="cancelBtn" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Annuler
          </button>
        </div>
      </form>

      <% } %>
    </div>
  </div>

  <% if (message) { %>
    <div class="container-fluid p-0">
      <div class="alert alert-<%= message.type %> w-75 mb-0" id="myAlert" role="alert">
        <%= message.text %>
      </div>
    </div>
  <% } %>

  <!-- Liste des tickets -->
  <div id="ticketListContainer" class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0 fw-bold">Liste des tickets</h5>
      <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#historiqueTicketsModal">
        <i class="bi bi-clock-history"></i> Historique
      </button>
    </div>

    <% if (tickets && tickets.length > 0) { %>
      <div class="table-responsive shadow-sm rounded" style="border: 1px solid #dee2e6;">
        <div class="d-flex justify-content-end mb-0">
          <!--  <input type="text" id="filterticketInput" class="form-control form-control-sm w-auto" placeholder="Filtrer ..."> -->
        </div>

        <table class="table table-hover align-middle table-bordered" id="dtable">
          <thead class="table-secondary">
            <tr>
              <th>#</th>
              <th>Client</th>
              <th>Quantité</th>
              <th>Nom chaffeur</th>
              <th>marque voiture</th>
              <th>status</th>
              <th>Date creation</th>
              <th>Date livraison</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% tickets.forEach((ticket, index) => { %>
              <% if (currentUser && ticket.statut != 'VENTE EFFECTUEE') { %>
               <tr id="ticket-<%= ticket.id %>">
                <th scope="row"><%= index + 1 %></th>
                <td><%= ticket.Client ? ticket.Client.nom + ' ' + ticket.Client.prenom : '-' %></td>
                <td><%= ticket.quantite %></td>
               
               <td><%= ticket.nom_chauffeur %></td>
               <td><%= ticket.marque_voiture %></td>
                <td>
                  <% if ( ticket.statut =='NON LIVRE') { %>
                    <span class="badge bg-danger text-dark"><%=ticket.statut %></span>
<% }%>
                    <% if (ticket.statut !='NON LIVRE') { %>
                    <span class="badge bg-success text-dark"><%=ticket.statut %></span>
                    <% }%>
                </td>
                <td>  <%= new Date(ticket.createdAt).toLocaleDateString('fr-FR') %></td>
                <td><%= ticket.date_livraison ? new Date(ticket.date_livraison).toLocaleDateString('fr-FR') : '' %></td>
                <td class="text-end">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      Actions
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                          <% if (currentUser && currentUser.profil === 'caissier' && ticket.statut =='NON LIVRE') { %>
                      <li>
                        <a class="dropdown-item text-warning" href="#" onclick='showSnackbarvalider(<%= ticket.id %>, "<%= ticket.Client ? ticket.Client.nom : "" %>")'>
                          <i class="bi bi-pencil"></i> Livré
                        </a>
                      </li>
                          <% }%>
                        <% if (currentUser && currentUser.profil === 'caissier' && ticket.statut != 'NON LIVRE') { %>
                      <li>
                        <button  class="btn btn-secondary " onclick="imprimerTicket(<%= ticket.id %>)">
                <i class="bi bi-printer"></i> print
                </button>
                       
                      </li>
                      <% }%>
<% if (peut('tickets.gerer') && ticket.statut == 'NON LIVRE') { %>
                      <li>
                        <a class="dropdown-item text-danger" href="#" onclick='showSnackbar(<%= ticket.id %>, "<%= ticket.Client ? ticket.Client.nom : "" %>")'>
                          <i class="bi bi-trash"></i> Supprimer
                        </a>
                      </li>
                      <% }%>

                      <% if (peut('tickets.gerer') && ticket.statut != 'NON LIVRE') { %>
                      <li>
                        <a class="dropdown-item text-success" href="#"
                           data-id="<%= ticket.id %>"
                           data-numero="<%= index + 1 %>"
                           data-client="<%= ticket.Client ? ticket.Client.nom : '' %>"
                           data-quantite="<%= ticket.quantite %>"
                           data-total="<%= ticket.quantite * prixUnitaireTicket %>"
                           onclick="ouvrirVenteTicket(this); return false;">
                          <i class="bi bi-check"></i> Effectuer vente
                        </a>
                      </li>
                      <% }%>


                    </ul>
                  </div>  
                </td>
              </tr>
              <% }%>
            <% }) %>

             
          </tbody>
        </table>
		   <br /><br /><br /><br /><br /><br /><br /><br /><br /><br />
      </div>
    <% } else { %>
      <div class="alert alert-info">Aucune ticket enregistrée.</div>
    <% } %>
  </div>
</div>

<!-- Modal Historique : tickets dont la vente est effectuée (retirés de la liste principale) -->
<% const ticketsVendus = (tickets || []).filter(t => t.statut == 'VENTE EFFECTUEE'); %>
<div class="modal fade" id="historiqueTicketsModal" tabindex="-1" aria-labelledby="historiqueTicketsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-secondary text-white">
        <h5 class="modal-title" id="historiqueTicketsModalLabel"><i class="bi bi-clock-history"></i> Historique des tickets (vente effectuée)</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <% if (ticketsVendus.length > 0) { %>
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <input type="text" id="historiqueRecherche" class="form-control" style="max-width:420px"
              placeholder="Rechercher : client, chauffeur, marque, date (ex : 31/10/2026)...">
            <span class="text-muted small"><span id="historiqueCompteur"><%= ticketsVendus.length %></span> / <%= ticketsVendus.length %> ticket(s)</span>
          </div>

          <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered align-middle mb-0" id="historiqueTable">
              <thead class="table-secondary">
                <tr>
                  <th>#</th>
                  <th>Client</th>
                  <th>Quantité</th>
                  <th>Nom chauffeur</th>
                  <th>Marque voiture</th>
                  <th>Date création</th>
                  <th>Date livraison</th>
                </tr>
              </thead>
              <tbody>
                <% ticketsVendus.forEach((ticket, index) => { %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td class="h-recherche"><%= ticket.Client ? ticket.Client.nom + ' ' + ticket.Client.prenom : '-' %></td>
                    <td><%= ticket.quantite %></td>
                    <td class="h-recherche"><%= ticket.nom_chauffeur %></td>
                    <td class="h-recherche"><%= ticket.marque_voiture %></td>
                    <td class="h-recherche"><%= new Date(ticket.createdAt).toLocaleDateString('fr-FR') %></td>
                    <td class="h-recherche"><%= ticket.date_livraison ? new Date(ticket.date_livraison).toLocaleDateString('fr-FR') : '-' %></td>
                  </tr>
                <% }) %>
                <tr id="historiqueAucunResultat" style="display:none">
                  <td colspan="7" class="text-center text-muted">Aucun ticket ne correspond à la recherche.</td>
                </tr>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="alert alert-info mb-0">Aucun ticket avec vente effectuée pour le moment.</div>
        <% } %>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

<!-- Snackbar de suppression -->
<div id="snackbar" class="snackbar shadow">
  <span id="snackbar-message">Confirmer la suppression ?</span>
  <form id="snackbarForm" method="POST" class="d-inline">
    <button type="submit" class="btn btn-danger btn-sm ms-3">Oui, supprimer</button>
    <button type="button" class="btn btn-secondary btn-sm ms-1" onclick="hideSnackbar()">Annuler</button>
  </form>
</div>

<!-- Snackbar de validation -->
<div id="snackbarv" class="snackbar shadow">
  <span id="snackbar-messagev">Confirmer la validation ?</span>
  <form id="snackbarFormv" method="POST" class="d-inline">
    <button type="submit" class="btn btn-success btn-sm ms-3">Oui, valider</button>
    <button type="button" class="btn btn-secondary btn-sm ms-1" onclick="hideSnackbarv()">Annuler</button>
  </form>
</div>

<!-- Fenêtre « Effectuer vente » : date de paiement et montant reçu (obligatoires) -->
<div class="modal fade" id="venteTicketModal" tabindex="-1" aria-labelledby="venteTicketModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form id="venteTicketForm" method="POST" class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title text-white" id="venteTicketModalLabel"><i class="bi bi-cart-check me-2"></i>Effectuer la vente</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3" id="venteTicketResume"></p>
        <div class="row g-2">
          <div class="col-sm-6">
            <label for="ticket_date_paiement" class="form-label">Date de paiement <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="ticket_date_paiement" name="date_paiement" required>
            <div class="form-text">Date de la vente et du paiement (au plus aujourd’hui).</div>
          </div>
          <div class="col-sm-6">
            <label for="ticket_montant_recu" class="form-label">Montant reçu <span class="text-danger">*</span></label>
            <input type="number" class="form-control" id="ticket_montant_recu" name="montant_recu" min="0" step="any" required placeholder="0 si rien payé">
            <div class="form-text" id="ticketMontantAide"></div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Effectuer la vente</button>
      </div>
    </form>
  </div>
</div>

<!-- Snackbar styles -->
<style>
  .snackbar {
    visibility: hidden;
    min-width: 320px;
    max-width: 90%;
    background-color: #323232;
    color: #fff;
    text-align: left;
    border-radius: 8px;
    padding: 16px;
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease-in-out, visibility 0.3s;
  }

  .snackbar.show {
    visibility: visible;
    opacity: 1;
  }
</style>

<!-- Scripts -->
<script>
  const ticketForm = document.getElementById('ticketForm');
  const ticketIdInput = document.getElementById('ticketId');
  const clientInput = document.getElementById('id_client');
  const quantiteInput = document.getElementById('quantite');
  const statutInput = document.getElementById('statut');
  const submitText = document.getElementById('submitText');
  const cancelBtn = document.getElementById('cancelBtn');
  const formStatus = document.getElementById('formStatus');
  const ticketListContainer = document.getElementById('ticketListContainer');

  function editticket(ticket) {
    ticketIdInput.value = ticket.id;
    clientInput.value = ticket.id_client;
    quantiteInput.value = ticket.quantite;
    statutInput.value = ticket.statut;
    submitText.textContent = 'Modifier';

    formStatus.innerHTML = `
      <div class="alert alert-warning py-1 px-3 mb-3">
        <i class="bi bi-pencil-square"></i> Mode <strong>modification</strong> activé pour : <strong>${ticket.Client ? ticket.Client.nom : ""}</strong>
      </div>
    `;

    ticketListContainer.style.display = 'none';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
if (cancelBtn) {
  cancelBtn.addEventListener('click', () => {
    ticketForm.reset();
    ticketIdInput.value = '';
    submitText.textContent = 'Ajouter';
    formStatus.innerHTML = '';
    ticketListContainer.style.display = '';
  });
}
  // Auto-hide flash messages
  document.addEventListener('DOMContentLoaded', () => {
    const alert = document.getElementById('myAlert');
    if (alert) setTimeout(() => alert.style.display = 'none', 3000);
  });

  // Snackbar logic
  const snackbar = document.getElementById('snackbar');
  const snackbarMessage = document.getElementById('snackbar-message');
  const snackbarForm = document.getElementById('snackbarForm');

   const snackbarv = document.getElementById('snackbarv');
  const snackbarMessagev = document.getElementById('snackbar-messagev');
  const snackbarFormv = document.getElementById('snackbarFormv');

  function showSnackbar(id, clientName) {
    snackbarMessage.innerHTML = `Supprimer la ticket du client "<strong>${clientName}</strong>" ?`;
    snackbarForm.action = `/tickets/delete/${id}`;
    snackbar.classList.add('show');
  }

  // Ouvre la fenêtre « Effectuer vente » d'un ticket (données lues sur le lien)
  function ouvrirVenteTicket(lien) {
    const { id, numero, client, quantite } = lien.dataset;
    const form = document.getElementById('venteTicketForm');
    form.reset();
    form.action = `/tickets/vente/${id}`;

    const resume = document.getElementById('venteTicketResume');
    resume.textContent = '';
    resume.append(`Ticket n° ${numero} — `);
    const nom = document.createElement('strong');
    nom.textContent = client || 'Client';
    resume.append(nom, ` — ${quantite} sachet(s)`);

    // Date de paiement : aujourd'hui par défaut, jamais dans le futur ; montant reçu : au plus le total (0 si rien payé)
    const aujourdhui = new Date().toLocaleDateString('en-CA');
    const datePaiement = document.getElementById('ticket_date_paiement');
    datePaiement.max = aujourdhui;
    datePaiement.value = aujourdhui;
    const total = Number(lien.dataset.total) || 0;
    document.getElementById('ticket_montant_recu').max = total;
    document.getElementById('ticketMontantAide').textContent =
      `Total : ${new Intl.NumberFormat('fr-FR').format(total)} F (tout payé = vente réglée, 0 = rien payé).`;

    const modalEl = document.getElementById('venteTicketModal');
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
    modalEl.addEventListener('shown.bs.modal', () => document.getElementById('ticket_montant_recu').focus(), { once: true });
  }


  function showSnackbarvalider(id, clientName) {
    snackbarMessagev.innerHTML = `Livré le ticket du client "<strong>${clientName}</strong>" ?`;
    snackbarFormv.action = `/tickets/livre/${id}`;
    snackbarv.classList.add('show');
  }

  function hideSnackbar() {
    snackbar.classList.remove('show');
  }

  function hideSnackbarv() {
    snackbarv.classList.remove('show');
  }

  // Recherche dans l'historique : client, chauffeur, marque, date création ou date livraison
  document.addEventListener('DOMContentLoaded', () => {
    const recherche = document.getElementById('historiqueRecherche');
    if (!recherche) return;

    const lignes = Array.from(document.querySelectorAll('#historiqueTable tbody tr'))
      .filter(tr => tr.id !== 'historiqueAucunResultat');
    const compteur = document.getElementById('historiqueCompteur');
    const aucunResultat = document.getElementById('historiqueAucunResultat');

    recherche.addEventListener('input', () => {
      const filtre = recherche.value.trim().toLowerCase();
      let nbVisibles = 0;
      lignes.forEach(tr => {
        const texte = Array.from(tr.querySelectorAll('.h-recherche')).map(td => td.textContent).join(' ').toLowerCase();
        const visible = texte.includes(filtre);
        tr.style.display = visible ? '' : 'none';
        if (visible) nbVisibles++;
      });
      compteur.textContent = nbVisibles;
      aucunResultat.style.display = nbVisibles === 0 ? '' : 'none';
    });

    // Recherche remise à zéro à chaque ouverture du modal
    document.getElementById('historiqueTicketsModal').addEventListener('show.bs.modal', () => {
      recherche.value = '';
      recherche.dispatchEvent(new Event('input'));
    });
  });

  // Filtre de table
  document.addEventListener('DOMContentLoaded', () => {
    const filterInput = document.getElementById('filterticketInput');
    const table = document.querySelector('#ticketListContainer table');
    if (!filterInput || !table) return;

    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));

    filterInput.addEventListener('input', () => {
      const filterValue = filterInput.value.toLowerCase();
      rows.forEach(row => {
        const clientCell = row.querySelector('td:nth-child(2)');
        const statutCell = row.querySelector('td:nth-child(4)');
        const clientText = clientCell ? clientCell.textContent.toLowerCase() : '';
        const statutText = statutCell ? statutCell.textContent.toLowerCase() : '';
        row.style.display = (clientText.includes(filterValue) || statutText.includes(filterValue)) ? '' : 'none';
      });
    });
  });



  function imprimerTicket(idTicket) {
  const row = document.querySelector(`#ticket-${idTicket}`);
  if (!row) return alert("Ticket introuvable.");

  const data = Array.from(row.children).map(td => td.innerText);
  console.log(row);
  
  const dateImpression = new Date().toLocaleDateString('fr-FR');

  const printWindow = window.open('', '_blank');
  printWindow.document.write(`
    <html>
      <head>
        <title>Fiche de ticket - BAMTI</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        <style>
          body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 40px;
            color: #333;
          }
          .facture-container {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            padding: 30px;
          }
          .entete {
            text-align: center;
            border-bottom: 2px solid #0d6efd;
            margin-bottom: 25px;
            padding-bottom: 10px;
          }
          .entete h3 {
            color: #0d6efd;
            font-weight: bold;
          }
          table {
            width: 100%;
            margin-top: 10px;
          }
          th {
            background-color: #e9ecef !important;
          }
          .signature {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
          }
          .signature div {
            width: 45%;
            text-align: center;
            font-size: 14px;
          }
          footer {
            text-align: center;
            margin-top: 40px;
            font-size: 13px;
            color: #777;
          }
          @media print {
            button { display: none; }
            body { margin: 10mm; }
          }
        </style>
      </head>
      <body>
        <div class="container facture-container">
        
		  
		  <div class="entete">
            <h2>Entreprise BAMTI</h2>
            <p>NIF:64750/P </p>
            <p>Adresse : SONUCI KOUBIA | Tél : 99582158/90231123</p>
            <small>Date d'impression : ${dateImpression}</small>
          </div>

          <h5 class="text-center text-primary mb-3">Détails du ticket</h5>

          <table class="table table-bordered table-striped">
            <thead class="table-light">
              <tr>
                
                <th scope="col">Client</th>
                <th scope="col">Quantité</th>
                <th scope="col">Nom chauffeur</th>
                <th scope="col">Marque</th>
           
              </tr>
            </thead>
            <tbody>
              <tr>
               <td>${data[1]}</td>
                <td>${data[2]}</td>
                <td>${data[3]}</td>
                <td>${data[4]}</td>
               
              </tr>
            </tbody>
          </table>

          <div class="signature mt-5">
            <div>
              <p>________________________</p>
              <p><strong>Signature Chauffeur</strong></p>
            </div>
            <div>
              <p>________________________</p>
              <p><strong>Signature Caissier</strong><br> <%= currentUser.nom %></p>
            </div>
          </div>

          <footer>
            <p>Merci pour votre confiance  — © Entreprise BAMTI</p>
          </footer>
        </div>
      </body>
    </html>
  `);

  printWindow.document.close();
  printWindow.print();
}


</script>

<%- include('../partials/footer') %>
