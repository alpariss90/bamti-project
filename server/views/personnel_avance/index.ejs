<%- include('../partials/header', { pageTitle: 'Avances du Personnel' }) %>

<div class="container-fluid mt-4 mb-5 ">

  <!-- Card Avances du Personnel -->
  <div class="card shadow-sm mt-0">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Gestion des Avances du Personnel</h4>
    </div>

    <div class="card-body">
      <!-- Message flash -->
      <% if(message) { %>
        <div class="alert alert-<%= message.type %> py-2 px-3 mb-3">
          <%= message.text %>
        </div>
      <% } %>

      <!-- Formulaire création avance -->
      <form id="avanceForm" action="/personnel_avance/create" method="POST" class="row g-3 align-items-end">
        <div class="col-md-3">
          <label for="id_personnel" class="form-label">Personnel</label>
          <select name="id_personnel" id="id_personnel" class="form-select select2-client" required>
            <option value="">Sélectionner</option>
            <% personnels.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.nom %> <%= p.prenom %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-1">
          <label for="jour" class="form-label">Jour</label>
          <select name="jour" id="jour" class="form-select" required>
            <option value="1">1</option>
<option value="2">2</option>
<option value="3">3</option>
<option value="4">4</option>
<option value="5">5</option>
<option value="6">6</option>
<option value="7">7</option>
<option value="8">8</option>
<option value="9">9</option>
<option value="10">10</option>
<option value="11">11</option>
<option value="12">12</option>
<option value="13">13</option>
<option value="14">14</option>
<option value="15">15</option>
<option value="16">16</option>
<option value="17">17</option>
<option value="18">18</option>
<option value="19">19</option>
<option value="20">20</option>
<option value="21">21</option>
<option value="22">22</option>
<option value="23">23</option>
<option value="24">24</option>
<option value="25">25</option>
<option value="26">26</option>
<option value="27">27</option>
<option value="28">28</option>
<option value="29">29</option>
<option value="30">30</option>
<option value="31">31</option>
          </select>
        </div>



         <div class="col-md-2">
          <label for="mois" class="form-label">Mois</label>
          <select name="mois" id="mois" class="form-select" required>
            <option value="">Sélectionner un mois </option>
            <option value="1">JANVIER</option>
            <option value="2">FEVRIER</option>
            <option value="3">MARS</option>
            <option value="4">AVRIL</option>
            <option value="5">MAI</option>
            <option value="6">JUIN</option>
            <option value="7">JUILLET</option>
            <option value="8">AOUT</option>
            <option value="9">SEPTEMBRE</option>
            <option value="10">OCTOBRE</option>
            <option value="11">NOVEMBRE</option>
            <option value="12">DECEMBRE</option>
          </select>
        </div>

        <div class="col-md-2">
 <label for="annee" class="form-label">Année</label>
   <select name="annee" id="annee" class="form-select" required>
    <option value="">Sélectionner une année</option>
    <% for (let i = 2025; i <= 2035; i++) { %>
      <option value="<%= i %>" <%= i === new Date().getFullYear() ? 'selected' : '' %>><%= i %></option>
    <% } %>
  </select>
</div>


        <div class="col-md-2">
          <label for="type" class="form-label">Type</label>
          <select name="type" id="type" class="form-select" required>
             <option value="">selectionner un type</option>
            <option value="credit">Crédit</option>
            <option value="gratification">Gratification</option>
          </select>
        </div>

        <div class="col-md-2">
          <label for="montant" class="form-label">Montant</label>
          <input type="number" step="0.01" name="montant" id="montant" class="form-control" required>
        </div>

        <div class="col-md-12">
          <label for="observation" class="form-label">Observation</label>
          <input type="text" name="observation" id="observation" class="form-control" required>
        </div>

        <div class="col-12 d-flex justify-content-end gap-2">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter
          </button>
          <button type="reset" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Annuler
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Tableau des avances -->
  <div id="avanceListContainer" class="mt-2">
    <h5 class="mb-3 fw-bold">Liste des avances</h5>

    <% if (avances && avances.length > 0) { %>
      <div class="table-wrapper shadow-sm rounded border" style="border: 1px solid #dee2e6;">
        <!-- Barre de recherche -->
        <div class="d-flex justify-content-end bg-white p-2 sticky-top" style="z-index: 10;">
        <!--   <input type="text" id="searchInput" class="form-control form-control-sm w-auto" placeholder="Rechercher ...">  -->
        </div>

        <!-- Conteneur scrollable -->
        <div class="table-container">
          <table id="dtable" class="table table-hover align-middle table-bordered mb-0">
            <thead class="table-secondary " >
              <tr>
                <th>#</th>
                <th>Jour</th>
                <th>Filtre</th>
                <th>Personnel</th>
                <th>Mois</th>
                <th>Année</th>
                <th>Type</th>
                <th>Montant</th>
                <th>Observation</th>
              </tr>
            </thead>
            <tbody>
              <% avances.forEach((a, index) => { %>
                <tr>
                  
                   <th scope="row"><%= index + 1 %></th>
                   <th scope="row"><%= a.jour %></th>
                  <th >
                    <%= ["","JANVIER","FÉVRIER","MARS","AVRIL","MAI","JUIN","JUILLET","AOÛT","SEPTEMBRE","OCTOBRE","NOVEMBRE","DÉCEMBRE"][a.mois] %>--<%= a.annee %>
                  </th>
                  <td><%= a.personnel.nom %> <%= a.personnel.prenom %></td>
                  <td>
                    <%= ["","JANVIER","FÉVRIER","MARS","AVRIL","MAI","JUIN","JUILLET","AOÛT","SEPTEMBRE","OCTOBRE","NOVEMBRE","DÉCEMBRE"][a.mois] %>
                  </td>
                  <td><%= a.annee %></td>
                  <td><%= a.type %></td>
                  <td><%= new Intl.NumberFormat('fr-FR').format(a.montant) %> FCFA</td>
                  <td><%= a.observation %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
			 <br /><br /><br /><br /><br /><br /><br /><br /><br /><br />
        </div>
      </div>

      
    <% } else { %>
      <div class="alert alert-info">Aucune avance enregistrée.</div>
    <% } %>
  </div>
</div>


