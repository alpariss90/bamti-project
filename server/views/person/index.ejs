<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

 

  <div class="card shadow-sm mt-4">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Gestion du personnel</h4>
    </div>

    <div class="card-body">
      <!-- Formulaire -->
      <form id="personnelForm" action="/person/createOrUpdate" method="POST" class="row g-2 align-items-end">
        <input type="hidden" name="id" id="personnelId">

        <div id="formStatus" class="col-12"></div>

        <div class="col-md-3">
          <label for="nom" class="form-label">Nom</label>
          <input type="text" class="form-control" id="nom" name="nom" required>
        </div>

        <div class="col-md-3">
          <label for="prenom" class="form-label">Prénom</label>
          <input type="text" class="form-control" id="prenom" name="prenom" required>
        </div>

        <div class="col-md-3">
          <label for="telephone" class="form-label">Téléphone</label>
          <input type="text" class="form-control" id="telephone" name="telephone">
        </div>

        <div class="col-md-3" id="datePriseServiceGroup">
          <label for="date_prise_service" class="form-label">Date prise de service</label>
          <input type="date" class="form-control" id="date_prise_service" name="date_prise_service">
        </div>

        <div class="col-md-3">
          <label for="id_profil" class="form-label">Profil</label>
          <select class="form-control select2-client" id="id_profil" name="id_profil">
            <option value="">-- Choisir un profil --</option>
            <% profils.forEach(profil => { %>
              <option value="<%= profil.id %>"><%= profil.libelle %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-3 d-flex justify-content-end gap-2">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> <span id="submitText">Ajouter</span>
          </button>
          <button type="button" id="cancelBtn" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Annuler
          </button>
        </div>
      </form>
    </div>
  </div>
 <% if (message) { %>
  <div class="container-fluid p-0">
    <div class="alert alert-<%= message.type %> w-75 mb-0" id="myAlert" role="alert">
      <%= message.text %>
    </div>
  </div>
<% } %>
  <!-- Liste du personnel -->
  <div id="personnelListContainer" class="mt-4">
    <h5 class="mb-3 fw-bold">Liste du personnel</h5>

    <% if (personnels && personnels.length > 0) { %>
      <div class="table-responsive shadow-sm rounded" style="border: 1px solid #dee2e6;">
        <div class="d-flex justify-content-end mb-0">
          <span id="exportButtonsPersonnel"></span>
        </div>

        <table class="table table-hover align-middle table-bordered" id="dtable">
          <thead class="table-secondary">
            <tr>
              <th>#</th>
              <th>Nom</th>
              <th>Prénom</th>
              <th>Téléphone</th>
              <th>Date prise de service</th>
              <th>Profil</th>
              <th>Durée de service</th>
              <th>État</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% personnels.forEach((personnel, index) => { %>
              <%
                const auj = new Date(); auj.setHours(0, 0, 0, 0);

                const prisesPersonnel = (personnel.services || []).filter(s => s.type === 'prise');
                const dernierePrise = prisesPersonnel.length ? prisesPersonnel[prisesPersonnel.length - 1] : null;
                let dureeJours = null;
                if (personnel.etat && dernierePrise) {
                  const dPrise = new Date(dernierePrise.date_service); dPrise.setHours(0, 0, 0, 0);
                  dureeJours = Math.floor((auj - dPrise) / 86400000);
                }

                const congeActif = (personnel.conges || []).find(c => {
                  const d = new Date(c.date_depart); d.setHours(0, 0, 0, 0);
                  const r = new Date(c.date_retour); r.setHours(0, 0, 0, 0);
                  return d <= auj && auj <= r;
                });
              %>
              <tr>
                <th scope="row"><%= index + 1 %></th>
                <td><%= personnel.nom %></td>
                <td><%= personnel.prenom %></td>
                <td><%= personnel.telephone || '-' %></td>
                <td><%= personnel.date_prise_service ? new Date(personnel.date_prise_service).toLocaleDateString('fr-FR') : '-' %></td>
                <td><%= personnel.profil ? personnel.profil.libelle : '-' %></td>
                <td><%= dureeJours !== null ? dureeJours + ' jour' + (dureeJours > 1 ? 's' : '') : '-' %></td>
                <td>
                  <% if (personnel.etat) { %>
                    <span class="badge bg-success">Actif</span>
                  <% } else { %>
                    <span class="badge bg-danger">Inactif</span>
                  <% } %>
                  <% if (congeActif) { %>
                    <button type="button" class="btn btn-sm btn-link p-0 ms-1" title="En congé"
                      onclick='ouvrirModalCongeInfo(<%- JSON.stringify({
                        nom: personnel.nom + " " + personnel.prenom,
                        date_depart: congeActif.date_depart,
                        nombre_jours: congeActif.nombre_jours,
                        date_retour: congeActif.date_retour,
                        motif: congeActif.motif
                      }) %>)'>
                      <i class="bi bi-airplane-fill text-info"></i>
                    </button>
                  <% } %>
                </td>
               <td class="text-end">
  <div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
      Actions
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
      <% if (personnel.etat && congeActif) { %>
        <li><span class="dropdown-item text-muted disabled"><i class="bi bi-airplane-fill"></i> En congé</span></li>
      <% } else if (personnel.etat) { %>
        <li>
          <button type="button" class="dropdown-item text-danger"
            data-id="<%= personnel.id %>" data-nom="<%= personnel.nom %> <%= personnel.prenom %>"
            onclick="ouvrirModalFinService(this)">
            <i class="bi bi-box-arrow-right"></i> Fin service
          </button>
        </li>
      <% } else { %>
        <li>
          <button type="button" class="dropdown-item text-success"
            data-id="<%= personnel.id %>" data-nom="<%= personnel.nom %> <%= personnel.prenom %>"
            onclick="ouvrirModalRepriseService(this)">
            <i class="bi bi-person-check"></i> Reprise service
          </button>
        </li>
      <% } %>
     <li> <a class="dropdown-item text-warning" href="#" onclick='editPersonnel(<%- JSON.stringify(personnel) %>)'>
      <i class="bi bi-pencil"></i> Modifier</a>
    </li>
    <li> <a class="dropdown-item" href="#" onclick='ouvrirModalDetails(<%- JSON.stringify(personnel) %>)'>
      <i class="bi bi-list-ul"></i> Détails</a>
    </li>
    </ul>
  </div>
</td>

              </tr>
            <% }) %>
          </tbody>
        </table>
		   <br /><br /><br /><br /><br /><br /><br /><br /><br /><br />
      </div>
    <% } else { %>
      <div class="alert alert-info">Aucun personnel enregistré.</div>
    <% } %>
  </div>
</div>

<!-- Snackbar de suppression -->
<div id="snackbar" class="snackbar shadow">
  <span id="snackbar-message">Confirmer la suppression ?</span>
  <form id="snackbarForm" method="POST" class="d-inline">
    <button type="submit" class="btn btn-danger btn-sm ms-3">Oui, supprimer</button>
    <button type="button" class="btn btn-secondary btn-sm ms-1" onclick="hideSnackbar()">Annuler</button>
  </form>
</div>

<!-- Modal Fin / Reprise de service -->
<div class="modal fade" id="finServiceModal" tabindex="-1" aria-labelledby="finServiceModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="finServiceForm" method="POST">
        <div class="modal-header bg-danger text-white" id="finServiceModalHeader">
          <h5 class="modal-title" id="finServiceModalLabel"><span id="finServiceTitre">Fin de service</span> — <span id="finServiceNom"></span></h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div class="mb-3">
            <label for="finServiceDate" class="form-label" id="finServiceDateLabel">Date fin de service</label>
            <input type="date" class="form-control" id="finServiceDate" name="date_service" required>
          </div>

          <div class="mb-3">
            <label for="finServiceMotif" class="form-label">Motif</label>
            <textarea class="form-control" id="finServiceMotif" name="motif" rows="3" required></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="submit" class="btn btn-danger" id="finServiceSubmitBtn">
            <i class="bi bi-check-circle"></i> Enregistrer
          </button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Détails historique de service -->
<div class="modal fade" id="detailsServiceModal" tabindex="-1" aria-labelledby="detailsServiceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-secondary text-white">
        <h5 class="modal-title" id="detailsServiceModalLabel">Historique de service — <span id="detailsServiceNom"></span></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="detailsServiceBody"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Info congé en cours -->
<div class="modal fade" id="congeInfoModal" tabindex="-1" aria-labelledby="congeInfoModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title" id="congeInfoModalLabel">Congé en cours — <span id="congeInfoNom"></span></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="list-unstyled mb-0">
          <li><strong>Date départ :</strong> <span id="congeInfoDepart"></span></li>
          <li><strong>Nombre de jours :</strong> <span id="congeInfoJours"></span></li>
          <li><strong>Date de retour :</strong> <span id="congeInfoRetour"></span></li>
          <li><strong>Motif :</strong> <span id="congeInfoMotif"></span></li>
        </ul>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

<!-- Snackbar styles -->
<style>
  .snackbar {
    visibility: hidden;
    min-width: 320px;
    max-width: 90%;
    background-color: #323232;
    color: #fff;
    text-align: left;
    border-radius: 8px;
    padding: 16px;
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease-in-out, visibility 0.3s;
  }

  .snackbar.show {
    visibility: visible;
    opacity: 1;
  }
</style>

<!-- Scripts -->
<script>
  const personnelForm = document.getElementById('personnelForm');
  const personnelIdInput = document.getElementById('personnelId');
  const nomInput = document.getElementById('nom');
  const prenomInput = document.getElementById('prenom');
  const telephoneInput = document.getElementById('telephone');
  const datePriseServiceInput = document.getElementById('date_prise_service');
  const datePriseServiceGroup = document.getElementById('datePriseServiceGroup');
  const idProfilInput = document.getElementById('id_profil');
  const submitText = document.getElementById('submitText');
  const cancelBtn = document.getElementById('cancelBtn');
  const formStatus = document.getElementById('formStatus');
  const personnelListContainer = document.getElementById('personnelListContainer');

  // Aucune date de service (prise ou arrêt) ne peut être postérieure à aujourd'hui
  const todayISO = new Date().toLocaleDateString('sv-SE'); // format YYYY-MM-DD en heure locale
  datePriseServiceInput.max = todayISO;

  function editPersonnel(personnel) {
    personnelIdInput.value = personnel.id;
    nomInput.value = personnel.nom;
    prenomInput.value = personnel.prenom || '';
    telephoneInput.value = personnel.telephone || '';
    datePriseServiceInput.value = personnel.date_prise_service || '';
    datePriseServiceGroup.style.display = personnel.date_prise_service ? 'none' : '';
    idProfilInput.value = personnel.id_profil || '';
    if (window.jQuery) $(idProfilInput).trigger('change');
    submitText.textContent = 'Modifier';

    formStatus.innerHTML = `
      <div class="alert alert-warning py-1 px-3 mb-3">
        <i class="bi bi-pencil-square"></i> Mode <strong>modification</strong> activé pour : <strong>${personnel.nom}</strong>
      </div>
    `;

    personnelListContainer.style.display = 'none';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  cancelBtn.addEventListener('click', () => {
    personnelForm.reset();
    personnelIdInput.value = '';
    datePriseServiceGroup.style.display = '';
    if (window.jQuery) $(idProfilInput).val('').trigger('change');
    submitText.textContent = 'Ajouter';
    formStatus.innerHTML = '';
    personnelListContainer.style.display = '';
  });

  // Auto-hide success message
  document.addEventListener('DOMContentLoaded', () => {
    const alert = document.getElementById('myAlert');
    if (alert) {
      setTimeout(() => alert.style.display = 'none', 3000);
    }
  });

  // Snackbar logic
  const snackbar = document.getElementById('snackbar');
  const snackbarMessage = document.getElementById('snackbar-message');
  const snackbarForm = document.getElementById('snackbarForm');

  function showSnackbar(id, nom) {
    snackbarMessage.innerHTML = `Supprimer le personnel "<strong>${nom}</strong>" ?`;
    snackbarForm.action = `/person/delete/${id}`;
    snackbar.classList.add('show');
  }

  function hideSnackbar() {
    snackbar.classList.remove('show');
  }

  // Modal Fin / Reprise de service
  function ouvrirModalService(btn, mode) {
    const id = btn.dataset.id;
    const nom = btn.dataset.nom;
    const estReprise = mode === 'reprise';

    document.getElementById('finServiceNom').textContent = nom || '';
    document.getElementById('finServiceTitre').textContent = estReprise ? 'Reprise de service' : 'Fin de service';
    document.getElementById('finServiceDateLabel').textContent = estReprise ? 'Date de reprise de service' : 'Date fin de service';
    document.getElementById('finServiceModalHeader').className = 'modal-header text-white ' + (estReprise ? 'bg-success' : 'bg-danger');
    document.getElementById('finServiceSubmitBtn').className = 'btn ' + (estReprise ? 'btn-success' : 'btn-danger');
    document.getElementById('finServiceForm').action = estReprise ? '/person/repriseService/' + id : '/person/finService/' + id;
    document.getElementById('finServiceForm').reset();
    document.getElementById('finServiceDate').max = todayISO;

    new bootstrap.Modal(document.getElementById('finServiceModal')).show();
  }

  function ouvrirModalFinService(btn) {
    ouvrirModalService(btn, 'fin');
  }

  function ouvrirModalRepriseService(btn) {
    ouvrirModalService(btn, 'reprise');
  }

  // Modal Détails historique de service
  function escapeHtml(str) {
    return String(str == null ? '' : str).replace(/[&<>"']/g, c => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
  }

  function ouvrirModalDetails(personnel) {
    document.getElementById('detailsServiceNom').textContent = `${personnel.nom || ''} ${personnel.prenom || ''}`;

    const services = personnel.services || [];
    const body = document.getElementById('detailsServiceBody');

    if (services.length === 0) {
      body.innerHTML = '<p class="text-muted mb-0">Aucun mouvement de service enregistré.</p>';
    } else {
      const rows = services.map(s => {
        const isPrise = s.type === 'prise';
        const badge = isPrise ? 'bg-success' : 'bg-danger';
        const label = isPrise ? 'Prise de service' : 'Fin de service';
        const dateStr = new Date(s.date_service).toLocaleDateString('fr-FR');
        const motif = s.motif ? escapeHtml(s.motif) : '-';
        return `<tr><td>${dateStr}</td><td><span class="badge ${badge}">${label}</span></td><td>${motif}</td></tr>`;
      }).join('');

      body.innerHTML = `
        <div class="table-responsive">
          <table class="table table-sm table-bordered align-middle mb-0">
            <thead class="table-light">
              <tr><th>Date</th><th>Type</th><th>Motif</th></tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      `;
    }

    new bootstrap.Modal(document.getElementById('detailsServiceModal')).show();
  }

  // Modal Info congé en cours
  function ouvrirModalCongeInfo(conge) {
    document.getElementById('congeInfoNom').textContent = conge.nom || '';
    document.getElementById('congeInfoDepart').textContent = new Date(conge.date_depart).toLocaleDateString('fr-FR');
    document.getElementById('congeInfoJours').textContent = conge.nombre_jours;
    document.getElementById('congeInfoRetour').textContent = new Date(conge.date_retour).toLocaleDateString('fr-FR');
    document.getElementById('congeInfoMotif').textContent = conge.motif || '-';

    new bootstrap.Modal(document.getElementById('congeInfoModal')).show();
  }
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
  const filterInput = document.getElementById('filterPersonnelInput');
  const table = document.querySelector('#personnelListContainer table');
  if (!filterInput || !table) return;

  const tbody = table.querySelector('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));

  filterInput.addEventListener('input', () => {
    const filterValue = filterInput.value.toLowerCase();

    rows.forEach(row => {
      const nomCell = row.querySelector('td:nth-child(2)');
      const telCell = row.querySelector('td:nth-child(4)');
      const nomText = nomCell ? nomCell.textContent.toLowerCase() : '';
      const telText = telCell ? telCell.textContent.toLowerCase() : '';

      // Afficher si nom OU téléphone contient le filtre
      if (nomText.includes(filterValue) || telText.includes(filterValue)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });
});

</script>
<%- include('../partials/footer') %>

<!-- DataTables Buttons (export Copier / Excel / PDF) — chargé après le footer
     pour que jQuery et DataTables (déjà inclus par le footer, qui a aussi déjà
     initialisé #dtable) soient prêts. -->
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.bootstrap5.min.css">
<script src="https://cdn.datatables.net/buttons/3.2.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script>
  if (document.getElementById('dtable')) {
    // retrieve: true récupère l'instance DataTable déjà créée par le footer,
    // sans la réinitialiser.
    const dtPersonnel = $('#dtable').DataTable({ retrieve: true });
    new $.fn.dataTable.Buttons(dtPersonnel, {
      buttons: [
        { extend: 'copyHtml5', text: '<i class="bi bi-clipboard"></i> Copier', className: 'btn btn-sm btn-outline-secondary' },
        { extend: 'excelHtml5', text: '<i class="bi bi-file-earmark-excel"></i> Excel', className: 'btn btn-sm btn-outline-success' },
        { extend: 'pdfHtml5', text: '<i class="bi bi-file-earmark-pdf"></i> PDF', className: 'btn btn-sm btn-outline-danger' },
      ],
    });
    dtPersonnel.buttons().container().appendTo('#exportButtonsPersonnel');
  }
</script>
