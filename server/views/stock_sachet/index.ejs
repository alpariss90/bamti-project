<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

 <% if (message) { %>
  <div class="container-fluid p-0">
    <div class="alert alert-<%= message.type %> w-75 mb-0" id="myAlert" role="alert">
      <%= message.text %>
    </div>
  </div>
<% } %>

  <div class="card shadow-sm mt-0">
    <div class="card-header text-white d-flex justify-content-between align-items-center" style="background:linear-gradient(135deg,#1e3a5f 0%,#0ea5c9 100%);">
      <h4 class="mb-0"><i class="bi bi-box-seam me-2"></i>Stock des sachets produits</h4>
      <div class="rounded-3 text-center py-1 px-3 bg-white">
        <div class="text-muted small mb-0">Stock actuel</div>
        <div class="fw-bold fs-5 text-primary"><%= stock %> sachets</div>
      </div>
    </div>

    <div class="card-body">
      <form id="entreeForm" action="/stock-sachet/create" method="POST" class="row g-3 align-items-end">
        <div class="col-md-3">
          <label for="quantite" class="form-label fw-semibold"><i class="bi bi-stack me-1 text-primary"></i>Quantité produite</label>
          <input type="number" min="1" class="form-control" id="quantite" name="quantite" required>
        </div>

        <div class="col-md-3">
          <label for="date_production" class="form-label fw-semibold"><i class="bi bi-calendar-date-fill me-1 text-primary"></i>Date de production</label>
          <input type="date" class="form-control" id="date_production" name="date_production" required>
        </div>

        <div class="col-md-4">
          <label for="observation" class="form-label fw-semibold"><i class="bi bi-chat-left-text me-1 text-primary"></i>Observation</label>
          <input type="text" class="form-control" id="observation" name="observation" placeholder="Optionnel">
        </div>

        <div class="col-md-2">
          <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-plus-circle me-1"></i>Enregistrer
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Historique des productions -->
  <div class="mt-4">
    <h5 class="mb-3 fw-bold">Historique des productions (entrées)</h5>

    <% if (entrees && entrees.length > 0) { %>
      <div class="table-responsive shadow-sm rounded" style="border: 1px solid #dee2e6;">
        <table class="table table-hover align-middle table-bordered" id="dtable">
          <thead class="table-secondary">
            <tr>
              <th>#</th>
              <th>Quantité produite</th>
              <th>Date de production</th>
              <th>Observation</th>
            </tr>
          </thead>
          <tbody>
            <% entrees.forEach((entree, index) => { %>
              <tr>
                <th scope="row"><%= index + 1 %></th>
                <td><%= entree.quantite %></td>
                <td><%= new Date(entree.date_production).toLocaleDateString('fr-FR') %></td>
                <td><%= entree.observation || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
		   <br /><br /><br /><br /><br /><br /><br /><br /><br /><br />
      </div>
    <% } else { %>
      <div class="alert alert-info">Aucune production enregistrée.</div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const alert = document.getElementById('myAlert');
    if (alert) {
      setTimeout(() => alert.style.display = 'none', 3000);
    }
  });
</script>

<%- include('../partials/footer') %>
