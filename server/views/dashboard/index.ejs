        function populateTopClientsTable() {
            const tbody = document.getElementById('topClientsTable');
            tbody.innerHTML = '';
            
            dashboardData.topClients.forEach(client => {
                const row = document.createElement('tr');
                
                let trendIcon = '';
                let trendClass = '';
                
                if (client.trend === 'up') {
                    trendIcon = '<i class="fas fa-arrow-up text-success"></i>';
                    trendClass = 'text-success';
                } else if (client.trend === 'down') {
                    trendIcon = '<i class="fas fa-arrow-down text-danger"></i>';
                    trendClass = 'text-danger';
                } else {
                    trendIcon = '<i class="fas fa-minus text-secondary"></i>';
                    trendClass = 'text-secondary';
                }
                
                row.innerHTML = `
                    <td><strong style="font-size: 0.9rem;">${client.name}</strong></td>
                    <td style="font-size: 0.85rem;">${formatCurrency(client.total)}</td>
                    <td style="font-size: 0.85rem;">${formatDate(client.lastOrder)}</td>
                    <td class="${trendClass}" style="font-size: 0.85rem;">${trendIcon}</td>
                `;
                
                tbody.appendChild(row);
            });
        }

