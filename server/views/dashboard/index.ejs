        function updateDailyChart() {
            const year = document.getElementById('yearSelect').value;
            const month = document.getElementById('monthSelect').value;
            
            // Ici, normalement, vous feriez un appel API pour récupérer les données
            // Pour l'exemple, nous générons des données aléatoires
            const daysInMonth = getDaysInMonth(parseInt(year), parseInt(month));
            
            // Générer de nouvelles données aléatoires
            const newLabels = Array.from({length: daysInMonth}, (_, i) => (i + 1).toString());
            const newSales = Array.from({length: daysInMonth}, () => Math.floor(Math.random() * 50000) + 15000);
            const newExpenses = Array.from({length: daysInMonth}, () => Math.floor(Math.random() * 15000) + 5000);
            
            // Mettre à jour le graphique
            dailySalesExpensesChart.data.labels = newLabels;
            dailySalesExpensesChart.data.datasets[0].data = newSales;
            dailySalesExpensesChart.data.datasets[1].data = newExpenses;
            dailySalesExpensesChart.update();
            
            // Mettre à jour le titre
            updateDailyChartTitle();
            
            console.log(`Graphique mis à jour pour ${month}/${year}`);
        }

        function updateDailyChartTitle() {
            const year = document.getElementById('yearSelect').value;
            const month = document.getElementById('monthSelect').value;
            const monthNames = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", 
                               "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
            const monthName = monthNames[parseInt(month) - 1];
            
            document.querySelector('#dailySalesExpensesChart').previousElementSibling.textContent = 
                `Ventes vs Dépenses Journalières - ${monthName} ${year}`;
        }

        function getDaysInMonth(year, month) {
            // Retourne le nombre de jours dans un mois donné
            return new Date(year, month, 0).getDate();
        }

        // Fonctions utilitaires
        function formatCurrency(amount) {
            if (amount >= 1000000) {
                return (amount/1000000).toFixed(1) + 'M';
            }
            if (amount >= 1000) {
                return (amount/1000).toFixed(0) + 'K';
            }
            return amount.toLocaleString('fr-FR');
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        }

