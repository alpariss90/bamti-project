        function updateRandomValue(elementId, maxChange) {
            const element = document.getElementById(elementId);
            const currentValue = parseInt(element.textContent.replace(/[^0-9]/g, ''));
            const randomChange = Math.floor(Math.random() * maxChange * 2) - maxChange;
            const newValue = Math.max(0, currentValue + randomChange);
            element.textContent = formatCurrency(newValue);
        }



        document.addEventListener('DOMContentLoaded', function() {
              const toggleBtn = document.getElementById('togglePasswordFormBtn');
            const formContainer = document.getElementById('passwordFormContainer');
            const closeBtn = document.getElementById('closePasswordForm');
            const cancelBtn = document.getElementById('cancelPasswordChange');
            
            // Fonction pour afficher/masquer le formulaire
            function togglePasswordForm() {
                if (formContainer.style.display === 'none' || formContainer.style.display === '') {
                    formContainer.style.display = 'block';
                    toggleBtn.innerHTML = '<i class="fas fa-times me-2"></i>Fermer';
                    toggleBtn.classList.remove('btn-info');
                    toggleBtn.classList.add('btn-danger');
                    // Scroll vers le formulaire
                    formContainer.scrollIntoView({ behavior: 'smooth' });
                } else {
                    formContainer.style.display = 'none';
                    toggleBtn.innerHTML = '<i class="fas fa-key me-2"></i>Changer Mot de Passe';
                    toggleBtn.classList.remove('btn-danger');
                    toggleBtn.classList.add('btn-info');
                }
            }
            
            // Événements pour les boutons
            if (toggleBtn) toggleBtn.addEventListener('click', togglePasswordForm);
            if (closeBtn) closeBtn.addEventListener('click', togglePasswordForm);
            if (cancelBtn) cancelBtn.addEventListener('click', togglePasswordForm);
            
            // ... (initialisation des graphiques) ...
            initSalesExpensesChart();
            initExpensesPieChart();
            initDailySalesExpensesChart();
            initSalesByClientChart();

        });

        document.getElementById('changePasswordForm')?.addEventListener('submit', function(e) {
