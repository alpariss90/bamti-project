<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

 

  <div class="card shadow-sm mt-0">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Gestion des Types de Dépenses</h4>
    </div>

    <div class="card-body">
      <!-- Formulaire création / modification -->
      <form id="typeDepenseForm" action="/type_depense/createOrUpdate" method="POST" class="row g-2 align-items-end">
        <input type="hidden" name="id" id="typeId" value="">

        <div id="formStatus" class="col-12"></div>

        <div class="col-md-10">
          <label for="libelle" class="form-label">Libellé</label>
          <input type="text" class="form-control" id="libelle" name="libelle" value="" required>
        </div>

        <div class="col-md-2 d-flex justify-content-end gap-2">
          <button type="submit" id="submitBtn" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> <span id="submitText">Ajouter</span>
          </button>
          <button type="button" id="cancelBtn" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Annuler
          </button>
        </div>
      </form>
    </div>
  </div>
 <% if (message) { %>
  <div class="container-fluid p-0">
    <div class="alert alert-<%= message.type %> w-75 mb-0" id="myAlert" role="alert">
      <%= message.text %>
    </div>
  </div>
<% } %>
  <!-- Liste des types de dépenses -->
  <div id="typeDepenseListContainer" class="mt-4">
    <h5 class="mb-3 fw-bold">Liste des types de dépenses</h5>

    <% if (types && types.length > 0) { %>
      <div class="table-responsive shadow-sm rounded" style="border: 1px solid #dee2e6;">
        <table class="table table-hover align-middle table-bordered" id="dtable">
          <thead class="table-secondary">
            <tr>
              <th>#</th>
              <th>Libellé</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% types.forEach((type, index) => { %>
              <tr>
                <th scope="row"><%= index + 1 %></th>
                <td><%= type.libelle %></td>
                <td class="text-end">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      Actions
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li>
                        <a class="dropdown-item edit-link" href="/type_depense/index/<%= type.id %>" data-id="<%= type.id %>">Modifier</a>
                      </li>
                      <li>
                      <!--  <button type="button" class="dropdown-item text-danger" onclick="showSnackbar('<%= type.id %>', '<%= type.libelle %>')">Supprimer</button> -->
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
		   <br /><br /><br /><br /><br /><br /><br /><br /><br /><br />
      </div>
    <% } else { %>
      <div class="alert alert-info">Aucun type de dépense enregistré.</div>
    <% } %>
  </div>
</div>

<!-- Snackbar de suppression -->
<div id="snackbar" class="snackbar shadow">
  <span id="snackbar-message">Confirmer la suppression ?</span>
  <form id="snackbarForm" method="POST" class="d-inline">
    <button type="submit" class="btn btn-danger btn-sm ms-3">Oui, supprimer</button>
    <button type="button" class="btn btn-secondary btn-sm ms-1" onclick="hideSnackbar()">Annuler</button>
  </form>
</div>

<!-- Styles Snackbar -->
<style>
  .snackbar {
    visibility: hidden;
    min-width: 320px;
    max-width: 90%;
    background-color: #323232;
    color: #fff;
    text-align: left;
    border-radius: 8px;
    padding: 16px;
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease-in-out, visibility 0.3s;
  }

  .snackbar.show {
    visibility: visible;
    opacity: 1;
  }
</style>

<!-- JS -->
<script>
  const typesData = <%- JSON.stringify(types) %>;

  const form = document.getElementById('typeDepenseForm');
  const typeIdInput = document.getElementById('typeId');
  const libelleInput = document.getElementById('libelle');
  const submitText = document.getElementById('submitText');
  const formStatus = document.getElementById('formStatus');
  const listContainer = document.getElementById('typeDepenseListContainer');
  const cancelBtn = document.getElementById('cancelBtn');

  function fillForm(type) {
    typeIdInput.value = type.id;
    libelleInput.value = type.libelle;
    submitText.textContent = 'Modifier';

    formStatus.innerHTML = `
      <div class="alert alert-warning py-1 px-3 mb-3">
        <i class="bi bi-pencil-square"></i> Mode <strong>modification</strong> activé pour : <strong>${type.libelle}</strong>
      </div>
    `;
  }

  // Gérer le clic sur "Modifier"
  document.querySelectorAll('.edit-link').forEach(link => {
    link.addEventListener('click', function(event) {
      event.preventDefault();

      const typeId = this.getAttribute('data-id');
      const type = typesData.find(t => t.id == typeId);

      if (type) {
        fillForm(type);
        listContainer.style.display = 'none';
        window.scrollTo({ top: 0, behavior: 'smooth' });

        // Modifier l'URL sans recharger la page
        history.pushState(null, '', `/type_depense/index/${typeId}`);
      } else {
        alert('Type de dépense non trouvé');
      }
    });
  });

  cancelBtn.addEventListener('click', () => {
    form.reset();
    typeIdInput.value = '';
    submitText.textContent = 'Ajouter';
    formStatus.innerHTML = '';
    listContainer.style.display = '';

    // Remettre l'URL à /type_depense/index sans id
    history.pushState(null, '', '/type_depense/index');
  });

  // Vérifier l'URL à l'ouverture et pré-remplir le formulaire si id présent
  function checkURLForId() {
    const path = window.location.pathname;
    const regex = /^\/type_depense\/index\/(\d+)$/; // /type_depense/index/id
    const match = path.match(regex);

    if (match) {
      const typeId = match[1];
      const type = typesData.find(t => t.id == typeId);
      if (type) {
        fillForm(type);
        listContainer.style.display = 'none';
      }
    }
  }

  // Exécuter au chargement
  document.addEventListener('DOMContentLoaded', () => {
    const alert = document.getElementById('myAlert');
    if (alert) {
      setTimeout(() => alert.style.display = 'none', 3000);
    }

    checkURLForId();
  });

  // Snackbar confirmation suppression
  const snackbar = document.getElementById('snackbar');
  const snackbarMessage = document.getElementById('snackbar-message');
  const snackbarForm = document.getElementById('snackbarForm');

  function showSnackbar(id, libelle) {
    snackbarMessage.innerHTML = `Supprimer le type de dépense "<strong>${libelle}</strong>" ?`;
    snackbarForm.action = `/type_depense/delete/${id}`;
    snackbar.classList.add('show');
  }

  function hideSnackbar() {
    snackbar.classList.remove('show');
  }
</script>

<%- include('../partials/footer') %>
