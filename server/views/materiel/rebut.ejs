<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

 <% if (message) { %>
  <div class="container-fluid p-0">
    <div class="alert alert-<%= message.type %> w-75 mb-0" id="myAlert" role="alert">
      <%= message.text %>
    </div>
  </div>
<% } %>

  <div class="card shadow-sm mt-0">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center"><i class="bi bi-exclamation-diamond me-2"></i>Rebut de matériel</h4>
    </div>

    <div class="card-body">
      <form id="rebutForm" action="/materiel/rebut/create" method="POST">
        <div class="row g-2 mb-3">
          <div class="col-md-3">
            <label for="date_rebut" class="form-label">Date du rebut</label>
            <input type="date" class="form-control" id="date_rebut" name="date_rebut" required>
          </div>
          <div class="col-md-6">
            <label for="motif" class="form-label">Motif</label>
            <input type="text" class="form-control" id="motif" name="motif" placeholder="Ex : cassé, usé, perdu..." required>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th>Matériel</th>
                <th style="width:160px">Quantité</th>
                <th style="width:60px"></th>
              </tr>
            </thead>
            <tbody id="lignesBody">
              <tr class="ligne-row">
                <td>
                  <select class="form-select select2-client" name="id_materiel[]" required>
                    <option value="">-- Choisir un matériel --</option>
                    <% materiels.forEach(m => { %>
                      <option value="<%= m.id %>"><%= m.libelle %> (stock : <%= m.stock %>)</option>
                    <% }) %>
                  </select>
                </td>
                <td><input type="number" min="1" class="form-control" name="quantite[]" required></td>
                <td><button type="button" class="btn btn-outline-danger btn-sm remove-ligne"><i class="bi bi-trash"></i></button></td>
              </tr>
            </tbody>
          </table>
        </div>

        <template id="ligneTemplate">
          <tr class="ligne-row">
            <td>
              <select class="form-select select2-client" name="id_materiel[]" required>
                <option value="">-- Choisir un matériel --</option>
                <% materiels.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.libelle %> (stock : <%= m.stock %>)</option>
                <% }) %>
              </select>
            </td>
            <td><input type="number" min="1" class="form-control" name="quantite[]" required></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm remove-ligne"><i class="bi bi-trash"></i></button></td>
          </tr>
        </template>

        <button type="button" id="addLigne" class="btn btn-outline-primary btn-sm mb-3">
          <i class="bi bi-plus-circle"></i> Ajouter une ligne
        </button>

        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-exclamation-diamond"></i> Enregistrer le rebut
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Liste des rebuts -->
  <div class="mt-4">
    <h5 class="mb-3 fw-bold">Historique des rebuts</h5>

    <% if (rebuts && rebuts.length > 0) { %>
      <div class="table-responsive shadow-sm rounded" style="border: 1px solid #dee2e6;">
        <table class="table table-hover align-middle table-bordered" id="dtable">
          <thead class="table-secondary">
            <tr>
              <th>#</th>
              <th>Matériel</th>
              <th>Quantité</th>
              <th>Motif</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% rebuts.forEach((rebut, index) => { %>
              <tr>
                <th scope="row"><%= index + 1 %></th>
                <td><%= rebut.materiel ? rebut.materiel.libelle : '-' %></td>
                <td><%= rebut.quantite %></td>
                <td><%= rebut.motif %></td>
                <td><%= new Date(rebut.date_rebut).toLocaleDateString('fr-FR') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
		   <br /><br /><br /><br /><br /><br /><br /><br /><br /><br />
      </div>
    <% } else { %>
      <div class="alert alert-info">Aucun rebut enregistré.</div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const alert = document.getElementById('myAlert');
    if (alert) {
      setTimeout(() => alert.style.display = 'none', 3000);
    }

    const tbody = document.getElementById('lignesBody');
    const template = document.getElementById('ligneTemplate');

    function attachRemove(row) {
      const btn = row.querySelector('.remove-ligne');
      btn.addEventListener('click', () => {
        if (tbody.querySelectorAll('.ligne-row').length > 1) {
          row.remove();
        }
      });
    }

    tbody.querySelectorAll('.ligne-row').forEach(attachRemove);

    document.getElementById('addLigne').addEventListener('click', () => {
      const clone = template.content.cloneNode(true);
      tbody.appendChild(clone);
      const newRow = tbody.lastElementChild;
      attachRemove(newRow);

      if (window.jQuery) {
        $(newRow).find('.select2-client').select2({
          theme: 'bootstrap4',
          placeholder: '-- Choisir un matériel --',
          allowClear: true
        });
      }
    });
  });
</script>

<%- include('../partials/footer') %>
