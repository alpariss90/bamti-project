<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

 <% if (message) { %>
  <div class="container-fluid p-0">
    <div class="alert alert-<%= message.type %> w-75 mb-0" id="myAlert" role="alert">
      <%= message.text %>
    </div>
  </div>
<% } %>

  <div class="card shadow-sm mt-0">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center"><i class="bi bi-bar-chart-line me-2"></i>Statistiques matériel</h4>
    </div>

    <div class="card-body">
      <form id="filtreForm" method="GET" action="/materiel/statistiques" class="row g-2 align-items-end mb-4">
        <div class="col-md-3">
          <label for="date" class="form-label">Une date précise</label>
          <input type="date" class="form-control" id="date" name="date" value="<%= date %>">
        </div>
        <div class="col-md-1 text-center text-muted">ou</div>
        <div class="col-md-3">
          <label for="date_debut" class="form-label">Du</label>
          <input type="date" class="form-control" id="date_debut" name="date_debut" value="<%= dateDebut %>">
        </div>
        <div class="col-md-3">
          <label for="date_fin" class="form-label">Au</label>
          <input type="date" class="form-control" id="date_fin" name="date_fin" value="<%= dateFin %>">
        </div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-funnel"></i> Filtrer
          </button>
        </div>
      </form>
      <% if (!date && !(dateDebut && dateFin)) { %>
        <p class="text-muted small">Aucun filtre appliqué : les totaux ci-dessous portent sur toute la période. Le stock actuel, lui, est toujours global.</p>
      <% } %>

      <div class="table-responsive shadow-sm rounded" style="border: 1px solid #dee2e6;">
        <table class="table table-hover align-middle table-bordered" id="dtable">
          <thead class="table-secondary">
            <tr>
              <th>Matériel</th>
              <th>Entrées</th>
              <th>Sorties</th>
              <th>Rebuts</th>
              <th>Stock actuel</th>
            </tr>
          </thead>
          <tbody>
            <% stats.forEach(s => { %>
              <tr>
                <td><%= s.libelle %></td>
                <td class="text-success fw-semibold">+<%= s.entrees %></td>
                <td class="text-danger fw-semibold">-<%= s.sorties %></td>
                <td class="text-warning fw-semibold">-<%= s.rebuts %></td>
                <td class="fw-bold"><%= s.stock %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const alert = document.getElementById('myAlert');
    if (alert) {
      setTimeout(() => alert.style.display = 'none', 3000);
    }
  });
</script>

<%- include('../partials/footer') %>
