<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>BAMTI — Connexion</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/assets/images/favicon.ico">
  <link href="/assets/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      display: flex;
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #0f172a;
      overflow: hidden;
    }

    /* ── Panneau gauche ─────────────────────────────── */
    .panel-left {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3rem;
      position: relative;
      background: linear-gradient(145deg, #1e3a5f 0%, #0f6e8c 50%, #0ea5c9 100%);
      overflow: hidden;
    }

    /* Cercles décoratifs */
    .panel-left::before {
      content: '';
      position: absolute;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
      top: -150px; left: -150px;
    }
    .panel-left::after {
      content: '';
      position: absolute;
      width: 350px; height: 350px;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
      bottom: -100px; right: -80px;
    }

    .brand-logo {
      width: 110px; height: 110px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid rgba(255,255,255,0.3);
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
      margin-bottom: 1.5rem;
      position: relative; z-index: 1;
    }

    .brand-title {
      color: #fff;
      font-size: 2.8rem;
      font-weight: 800;
      letter-spacing: 3px;
      position: relative; z-index: 1;
      text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .brand-subtitle {
      color: rgba(255,255,255,0.75);
      font-size: 1rem;
      margin-top: 0.5rem;
      position: relative; z-index: 1;
      text-align: center;
      max-width: 280px;
      line-height: 1.6;
    }

    .brand-divider {
      width: 60px; height: 3px;
      background: rgba(255,255,255,0.4);
      border-radius: 2px;
      margin: 1.2rem auto;
      position: relative; z-index: 1;
    }

    .brand-stats {
      display: flex;
      gap: 2rem;
      margin-top: 2rem;
      position: relative; z-index: 1;
    }

    .brand-stat {
      text-align: center;
      color: rgba(255,255,255,0.85);
    }

    .brand-stat .number {
      font-size: 1.6rem;
      font-weight: 700;
      color: #fff;
    }

    .brand-stat .label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      opacity: 0.7;
    }

    /* Vagues animées */
    .waves {
      position: absolute;
      bottom: 0; left: 0;
      width: 100%;
      z-index: 0;
    }

    .wave {
      position: absolute;
      bottom: 0; left: 0;
      width: 200%;
      height: 120px;
      background: rgba(255,255,255,0.05);
      border-radius: 50% 50% 0 0;
      animation: wave-anim 6s linear infinite;
    }

    .wave:nth-child(2) {
      background: rgba(255,255,255,0.03);
      animation-delay: -2s;
      animation-duration: 8s;
    }

    .wave:nth-child(3) {
      background: rgba(255,255,255,0.06);
      animation-delay: -4s;
      animation-duration: 10s;
    }

    @keyframes wave-anim {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ── Panneau droit ──────────────────────────────── */
    .panel-right {
      width: 460px;
      min-width: 380px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3rem 3rem;
      background: #fff;
      position: relative;
    }

    .panel-right::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 4px; height: 100%;
      background: linear-gradient(to bottom, #0f6e8c, #0ea5c9);
    }

    .login-header {
      margin-bottom: 2.5rem;
    }

    .login-header h2 {
      font-size: 1.75rem;
      font-weight: 700;
      color: #1e3a5f;
    }

    .login-header p {
      color: #64748b;
      font-size: 0.9rem;
      margin-top: 0.4rem;
    }

    /* Champs */
    .field-group {
      position: relative;
      margin-bottom: 1.4rem;
    }

    .field-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: #475569;
      margin-bottom: 0.5rem;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .field-wrap {
      position: relative;
    }

    .field-wrap .field-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 1rem;
      pointer-events: none;
    }

    .field-wrap input {
      width: 100%;
      padding: 0.75rem 1rem 0.75rem 2.75rem;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      font-size: 0.95rem;
      color: #1e293b;
      background: #f8fafc;
      transition: all 0.2s;
      outline: none;
    }

    .field-wrap input:focus {
      border-color: #0ea5c9;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(14,165,201,0.12);
    }

    .field-wrap input.is-invalid {
      border-color: #ef4444;
      background: #fff;
    }

    .field-wrap .toggle-pw {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #94a3b8;
      font-size: 1rem;
      background: none;
      border: none;
      padding: 0;
    }

    .field-wrap .toggle-pw:hover { color: #0f6e8c; }

    .invalid-msg {
      font-size: 0.78rem;
      color: #ef4444;
      margin-top: 0.3rem;
      display: none;
    }

    .was-validated .field-wrap input:invalid ~ .invalid-msg { display: block; }

    /* Bouton */
    .btn-login {
      width: 100%;
      padding: 0.85rem;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, #1e3a5f, #0ea5c9);
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all 0.25s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .btn-login:hover {
      background: linear-gradient(135deg, #0f2a4a, #0891b2);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(14,165,201,0.35);
    }

    .btn-login:active { transform: translateY(0); }

    /* Alert */
    .login-alert {
      border-radius: 10px;
      font-size: 0.88rem;
      padding: 0.75rem 1rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .login-alert.error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
    }

    .login-alert.success {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #15803d;
    }

    /* Footer */
    .panel-footer {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #f1f5f9;
      text-align: center;
      color: #94a3b8;
      font-size: 0.78rem;
    }

    /* Responsive : empiler les panneaux */
    @media (max-width: 768px) {
      body { flex-direction: column; overflow: auto; }
      .panel-left { padding: 2.5rem 1.5rem; min-height: 220px; }
      .brand-title { font-size: 2rem; }
      .brand-stats { gap: 1.5rem; }
      .panel-right { width: 100%; min-width: unset; padding: 2rem 1.5rem; }
      .panel-right::before { width: 100%; height: 4px; top: 0; left: 0; }
    }
  </style>
</head>
<body>

  <!-- ── Panneau gauche : branding ────────────────────── -->
  <div class="panel-left">
    <div class="waves">
      <div class="wave"></div>
      <div class="wave"></div>
      <div class="wave"></div>
    </div>

    <img src="/images/logo.jpeg" alt="Logo BAMTI" class="brand-logo"
         onerror="this.style.display='none'">

    <div class="brand-title">BAMTI</div>
    <div class="brand-divider"></div>
    <p class="brand-subtitle">
      Système de gestion intégré<br>
      <span style="opacity:.7;font-size:.85rem">SONUCI KOUBIA — Distribution d'eau</span>
    </p>

    <div class="brand-stats">
      <div class="brand-stat">
        <div class="number"><i class="bi bi-droplet-fill" style="font-size:1.4rem"></i></div>
        <div class="label">Production</div>
      </div>
      <div class="brand-stat">
        <div class="number"><i class="bi bi-truck" style="font-size:1.4rem"></i></div>
        <div class="label">Livraisons</div>
      </div>
      <div class="brand-stat">
        <div class="number"><i class="bi bi-people-fill" style="font-size:1.4rem"></i></div>
        <div class="label">Clients</div>
      </div>
    </div>
  </div>

  <!-- ── Panneau droit : formulaire ───────────────────── -->
  <div class="panel-right">

    <div class="login-header">
      <h2>Bon retour 👋</h2>
      <p>Connectez-vous pour accéder à votre espace de gestion.</p>
    </div>

    <!-- Flash message -->
    <% if (message) { %>
      <div class="login-alert <%= message.type === 'danger' || message.type === 'error' ? 'error' : 'success' %>">
        <i class="bi bi-<%= message.type === 'danger' || message.type === 'error' ? 'exclamation-circle' : 'check-circle' %>"></i>
        <%= message.text %>
      </div>
    <% } %>

    <form action="/login" method="POST" id="loginForm" novalidate>

      <div class="field-group">
        <label for="login">Identifiant</label>
        <div class="field-wrap">
          <i class="bi bi-person field-icon"></i>
          <input type="text" id="login" name="login"
                 placeholder="Votre identifiant" required autocomplete="username">
          <span class="invalid-msg">Veuillez saisir votre identifiant.</span>
        </div>
      </div>

      <div class="field-group">
        <label for="password">Mot de passe</label>
        <div class="field-wrap">
          <i class="bi bi-lock field-icon"></i>
          <input type="password" id="password" name="password"
                 placeholder="••••••••" required autocomplete="current-password">
          <button type="button" class="toggle-pw" onclick="togglePw()" tabindex="-1">
            <i class="bi bi-eye" id="eyeIcon"></i>
          </button>
          <span class="invalid-msg">Veuillez saisir votre mot de passe.</span>
        </div>
      </div>

      <button type="submit" class="btn-login">
        <i class="bi bi-box-arrow-in-right"></i>
        Se connecter
      </button>
    </form>

    <div class="panel-footer">
      &copy; <%= new Date().getFullYear() %> Entreprise BAMTI &mdash; NIF : 64750/P
    </div>
  </div>

  <script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    // Validation
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      if (!this.checkValidity()) {
        e.preventDefault();
        this.classList.add('was-validated');
        this.querySelectorAll('input:invalid').forEach(el => el.classList.add('is-invalid'));
      }
    });

    // Toggle mot de passe
    function togglePw() {
      const input = document.getElementById('password');
      const icon  = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
      } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
      }
    }
  </script>
</body>
</html>
