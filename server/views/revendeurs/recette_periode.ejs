<%- include('../partials/header') %>

<div class="container-fluid">
  <h4 class="fw-bold mb-3">
    <i class="bi bi-calendar-range me-2 text-primary"></i>Recette par période — Revendeur
  </h4>

  <!-- Filtre -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <form method="GET" action="/revendeurs/recette/periode" class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label fw-semibold">Revendeur</label>
          <select name="id_revendeur" class="form-select" required>
            <option value="">-- Choisir un revendeur --</option>
            <% revendeurs.forEach(r => { %>
              <option value="<%= r.id %>" <%= id_revendeur == r.id ? 'selected' : '' %>>
                <%= r.prenom %> <%= r.nom %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label fw-semibold">Date début</label>
          <input type="date" name="date_debut" class="form-control" value="<%= date_debut %>" required>
        </div>
        <div class="col-md-2">
          <label class="form-label fw-semibold">Date fin</label>
          <input type="date" name="date_fin" class="form-control" value="<%= date_fin %>" required>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-search me-1"></i>Afficher
          </button>
        </div>
      </form>
    </div>
  </div>

  <% if (revendeurChoisi && id_revendeur && date_debut && date_fin) { %>

    <!-- Totaux -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card border-0 bg-primary text-white shadow-sm">
          <div class="card-body text-center">
            <div class="fs-5 fw-bold"><%= totaux.totalVente?.toLocaleString('fr-FR') %> F</div>
            <div class="small">Total Ventes</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 bg-success text-white shadow-sm">
          <div class="card-body text-center">
            <div class="fs-5 fw-bold"><%= totaux.totalEncaisse?.toLocaleString('fr-FR') %> F</div>
            <div class="small">Total Encaissé</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 bg-danger text-white shadow-sm">
          <div class="card-body text-center">
            <div class="fs-5 fw-bold"><%= totaux.totalReste?.toLocaleString('fr-FR') %> F</div>
            <div class="small">Reste à Encaisser</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 bg-warning text-dark shadow-sm">
          <div class="card-body text-center">
            <div class="fs-5 fw-bold"><%= totaux.gainRevendeur?.toLocaleString('fr-FR') %> F</div>
            <div class="small">
              Gain revendeur (<%= totaux.totalQte %> sachets × <%= Number(revendeurChoisi.gain_par_sachet).toLocaleString('fr-FR') %> F)
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tableau -->
    <% if (ventes.length > 0) { %>
      <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
          <i class="bi bi-list-ul me-2"></i>
          Ventes de <strong><%= revendeurChoisi.prenom %> <%= revendeurChoisi.nom %></strong>
          du <%= new Date(date_debut).toLocaleDateString('fr-FR') %>
          au <%= new Date(date_fin).toLocaleDateString('fr-FR') %>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0" id="dtable">
              <thead class="table-secondary">
                <tr>
                  <th>#</th>
                  <th>Date</th>
                  <th>Client</th>
                  <th>Qté</th>
                  <th>Prix unit.</th>
                  <th>Montant total</th>
                  <th>Encaissé</th>
                  <th>Reste</th>
                  <th>Type paiement</th>
                </tr>
              </thead>
              <tbody>
                <% ventes.forEach((v, i) => { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td><%= new Date(v.date_vente).toLocaleDateString('fr-FR') %></td>
                    <td><%= v.Client?.nom %> <%= v.Client?.prenom %></td>
                    <td class="text-center"><%= v.quantite %></td>
                    <td class="text-end"><%= Number(v.prix_unitaire).toLocaleString('fr-FR') %></td>
                    <td class="text-end fw-semibold"><%= v.montantTotal?.toLocaleString('fr-FR') %> F</td>
                    <td class="text-end text-success"><%= v.montantPayes?.toLocaleString('fr-FR') %> F</td>
                    <td class="text-end <%= v.reste > 0 ? 'text-danger fw-bold' : 'text-success' %>">
                      <%= v.reste?.toLocaleString('fr-FR') %> F
                    </td>
                    <td class="text-center">
                      <span class="badge <%= v.type_paiement === 'total' ? 'bg-success' : 'bg-warning text-dark' %>">
                        <%= v.type_paiement === 'total' ? 'Payé total' : 'Échelonné' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Aucune vente pour cette période.
      </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/footer') %>
