<%- include('../partials/header') %>

<div class="container-fluid">
  <h4 class="fw-bold mb-3">
    <i class="bi bi-arrow-repeat me-2 text-success"></i>Synchroniser les données — Revendeur
  </h4>

  <% if (error) { %>
    <div class="alert alert-danger">
      <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
    </div>
  <% } %>

  <% if (result && result.message) { %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle me-2"></i><%= result.message %>
    </div>
  <% } %>

  <% if (result && !result.message) { %>
    <div class="alert alert-success">
      <i class="bi bi-check-circle me-2"></i>
      Synchronisation réussie pour <strong><%= result.revendeur %></strong> — <strong><%= new Date(result.date).toLocaleDateString('fr-FR') %></strong>
    </div>
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card border-0 bg-primary text-white shadow-sm">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold"><%= result.clients %></div>
            <div class="small">Nouveau(x) client(s) inséré(s)</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 bg-success text-white shadow-sm">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold"><%= result.ventes %></div>
            <div class="small">Vente(s) insérée(s)</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 bg-warning text-dark shadow-sm">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold"><%= result.paiements %></div>
            <div class="small">Paiement(s) inséré(s)</div>
          </div>
        </div>
      </div>
    </div>
    <% if (result.paiementsEnAttente) { %>
      <div class="alert alert-warning">
        <i class="bi bi-hourglass-split me-2"></i>
        <strong><%= result.paiementsEnAttente %></strong> versement(s) restent en attente : leur vente n’est pas encore validée.
        Ils seront intégrés quand vous validerez le jour de cette vente.
      </div>
    <% } %>
  <% } %>

  <!-- Formulaire -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-secondary text-white fw-semibold">
      <i class="bi bi-sliders me-2"></i>Paramètres de synchronisation
    </div>
    <div class="card-body">
      <form method="POST" action="/revendeurs/sync" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label fw-semibold">Revendeur</label>
          <select name="id_revendeur" class="form-select" required>
            <option value="">-- Choisir un revendeur --</option>
            <% revendeurs.forEach(r => { %>
              <option value="<%= r.id %>">
                <%= r.prenom %> <%= r.nom %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label fw-semibold">Date</label>
          <input type="date" name="date_sync" class="form-control" value="<%= today %>" required>
        </div>
        <div class="col-md-3">
          <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-arrow-repeat me-1"></i>Synchroniser
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Ce qui reste à valider (ventes : date de vente ; versements : date du versement) -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-light fw-semibold">
      <i class="bi bi-hourglass-split me-2 text-warning"></i>En attente de validation
    </div>
    <div class="card-body p-0">
      <% if (!enAttente.length) { %>
        <p class="text-muted text-center my-3">Rien en attente : tout est validé.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Revendeur</th>
                <th>Date</th>
                <th class="text-end">Ventes</th>
                <th class="text-end">Versements</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% enAttente.forEach(l => { %>
                <tr>
                  <td><%= l.revendeur %></td>
                  <td><%= new Date(l.jour).toLocaleDateString('fr-FR') %></td>
                  <td class="text-end"><%= l.nb_ventes %></td>
                  <td class="text-end"><%= l.nb_paiements %></td>
                  <td class="text-end">
                    <% if (l.id_revendeur) { %>
                      <form method="POST" action="/revendeurs/sync" class="d-inline">
                        <input type="hidden" name="id_revendeur" value="<%= l.id_revendeur %>">
                        <input type="hidden" name="date_sync" value="<%= l.jour %>">
                        <button type="submit" class="btn btn-sm btn-outline-success">
                          <i class="bi bi-arrow-repeat me-1"></i>Valider
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
