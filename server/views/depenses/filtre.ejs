<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

  <% if (message) { %>
    <div id="myAlert" class="alert alert-<%= message.type %> alert-dismissible fade show mt-2" role="alert">
      <%= message.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="card shadow-sm mt-3">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Filtrer les dépenses</h4>
    </div>

    <div class="card-body">
      <!-- Formulaire de filtre -->
      <form id="filtreForm" action="/depenses/filtre" method="GET" class="row g-2 align-items-end needs-validation" novalidate>
        
        <div class="col-md-3">
          <label for="id_type_depense" class="form-label">Type de dépense</label>
          <select class="form-select" id="id_type_depense" name="id_type_depense" required>
            <option value="">-- Choisir un type --</option>
            <option value="tous" <%= id_type_depense === 'tous' ? 'selected' : '' %>>Tous les types</option>
            <% types.forEach(type => { %>
              <option value="<%= type.id %>" <%= id_type_depense == type.id ? 'selected' : '' %>>
                <%= type.libelle %>
              </option>
            <% }) %>
          </select>
          <div class="invalid-feedback">Veuillez choisir un type de dépense.</div>
        </div>

        <div class="col-md-3">
          <label for="id_engin" class="form-label">Engin</label>
          <select class="form-select" id="id_engin" name="id_engin" required>
            <option value="">-- Choisir un engin --</option>
            <option value="tous" <%= id_engin === 'tous' ? 'selected' : '' %>>Tous les engins</option>
            <% engins.forEach(engin => { %>
              <option value="<%= engin.id %>" <%= id_engin == engin.id ? 'selected' : '' %>>
                <%= engin.libelle %>
              </option>
            <% }) %>
          </select>
          <div class="invalid-feedback">Veuillez choisir un engin.</div>
        </div>

        <div class="col-md-2">
          <label for="date_debut" class="form-label">Date début</label>
          <input type="date" class="form-control" id="date_debut" name="date_debut" value="<%= date_debut || '' %>" required>
          <div class="invalid-feedback">Date début obligatoire.</div>
        </div>

        <div class="col-md-2">
          <label for="date_fin" class="form-label">Date fin</label>
          <input type="date" class="form-control" id="date_fin" name="date_fin" value="<%= date_fin || '' %>" required>
          <div class="invalid-feedback">Date fin obligatoire.</div>
        </div>

        <div class="col-md-2 d-flex justify-content-end gap-2 mt-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel"></i> Filtrer
          </button>
          <a href="/depenses/index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Retour
          </a>
        </div>

      </form>
    </div>
  </div>

  <!-- Liste des dépenses filtrées -->
  <div id="depenseListContainer" class="mt-4">
    <h5 class="mb-3 fw-bold">Dépenses filtrées</h5>

    <% if (depenses && depenses.length > 0) { %>
      <div class="d-flex justify-content-end mb-2">
        <button class="btn btn-secondary" onclick="imprimerToutesLesDepenses()">
          <i class="bi bi-printer"></i> Imprimer les dépenses
        </button>
      </div>

      <div class="table-responsive shadow-sm rounded" style="height: 70vh; overflow-y: scroll; border: 1px solid #dee2e6;">
        <table id="depenseTable" class="table table-hover align-middle table-bordered mb-0">
          <thead class="table-secondary position-sticky top-0" style="z-index: 2;">
            <tr>
              <th>#</th>
              <th>Type de dépense</th>
              <th>Engin</th>
              <th>Montant total (F)</th>
            </tr>
          </thead>
          <tbody>
            <% depenses.forEach((dep, index) => { %>
              <tr>
                <th scope="row"><%= index + 1 %></th>
                <td><%= dep.typeDepense %></td>
                <td><%= dep.engin %></td>
                <td><%= new Intl.NumberFormat('fr-FR').format(dep.montantTotal.toFixed(2)) %> FCFA</td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot class="table-secondary fw-bold">
            <tr>
              <td colspan="3" class="text-center">Montant total global</td>
              <td><%= new Intl.NumberFormat('fr-FR').format(montantTotalGlobal.toFixed(2)) %> FCFA</td>
            </tr>
          </tfoot>
        </table>
      </div>

    <% } else { %>
      <div class="alert alert-info">Aucune dépense trouvée pour ce filtre.</div>
    <% } %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  (function () {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  })();

  function imprimerToutesLesDepenses() {
    const contenu = document.getElementById("depenseTable").outerHTML;
    const date = new Date().toLocaleDateString('fr-FR');
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
      <html>
        <head>
          <title>Dépenses filtrées - BAMTI</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 30px; color: #333; }
            table { width: 100%; border-collapse: collapse; margin-top: 20px; }
            th, td { border: 1px solid #dee2e6; padding: 8px; text-align: center; }
            th { background-color: #f8f9fa; }
            tr:nth-child(even) { background-color: #f9f9f9; }
            @media print { button { display: none; } }
          </style>
        </head>
        <body>
          <h2>Dépenses filtrées</h2>
          <p>Date : ${date}</p>
          ${contenu}
        </body>
      </html>
    `);
    printWindow.document.close();
    printWindow.print();
  }
</script>

<%- include('../partials/footer') %>
