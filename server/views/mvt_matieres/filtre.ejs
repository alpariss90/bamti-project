<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

  <% if (message) { %>
    <div id="myAlert" class="alert alert-<%= message.type %> alert-dismissible fade show mt-2" role="alert">
      <%= message.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- ======== CARD FILTRE ======== -->
  <div class="card shadow-sm mt-3">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Filtrer les mouvements de matières</h4>
    </div>

    <div class="card-body">
      <!-- Formulaire de filtre -->
      <form id="filtreForm" action="/mvt_matieres/filtre" method="GET" class="row g-2 align-items-end needs-validation" novalidate>

        <!-- Type de matière -->
        <div class="col-md-3">
          <label for="type_matiere" class="form-label">Type de matière</label>
          <select class="form-select" id="type_matiere" name="type_matiere" required>
            <option value="">-- Choisir une matière --</option>
            <option value="tous" <%= type_matiere === 'tous' ? 'selected' : '' %>>Toutes les matières</option>
            <% matieres.forEach(m => { %>
              <option value="<%= m %>" <%= type_matiere === m ? 'selected' : '' %>><%= m %></option>
            <% }) %>
          </select>
          <div class="invalid-feedback">Veuillez choisir une matière.</div>
        </div>

        <!-- Type de mouvement -->
        <div class="col-md-3">
          <label for="type_mvt" class="form-label">Type de mouvement</label>
          <select class="form-select" id="type_mvt" name="type_mvt" required>
            <option value="">-- Choisir un type --</option>
            <option value="tous" <%= type_mvt === 'tous' ? 'selected' : '' %>>Tous les types</option>
            <% typesMvt.forEach(t => { %>
              <option value="<%= t %>" <%= type_mvt === t ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>
          <div class="invalid-feedback">Veuillez choisir un type de mouvement.</div>
        </div>

        <!-- Date début -->
        <div class="col-md-2">
          <label for="date_debut" class="form-label">Date début</label>
          <input type="date" class="form-control" id="date_debut" name="date_debut" value="<%= date_debut || '' %>" required>
          <div class="invalid-feedback">Date début obligatoire.</div>
        </div>

        <!-- Date fin -->
        <div class="col-md-2">
          <label for="date_fin" class="form-label">Date fin</label>
          <input type="date" class="form-control" id="date_fin" name="date_fin" value="<%= date_fin || '' %>" required>
          <div class="invalid-feedback">Date fin obligatoire.</div>
        </div>

        <!-- Boutons -->
        <div class="col-md-2 d-flex justify-content-end gap-2 mt-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel"></i> Filtrer
          </button>
          <a href="/mvt_matieres/index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Retour
          </a>
        </div>

      </form>
    </div>
  </div>

  <!-- ======== TABLEAU RÉSULTATS ======== -->
  <div id="mvtListContainer" class="mt-4">
    <h5 class="mb-3 fw-bold">Mouvements filtrés</h5>

    <% if (mvtMatieres && mvtMatieres.length > 0) { %>
      <div class="d-flex justify-content-end align-items-center gap-2 mb-2">
        <span id="exportButtonsMvt"></span>
        <button class="btn btn-secondary" onclick="imprimerMouvements()">
          <i class="bi bi-printer"></i> Imprimer les mouvements
        </button>
      </div>

      <div class="table-responsive shadow-sm rounded" style="height: 70vh; overflow-y: scroll; border: 1px solid #dee2e6;">
        <table id="mvtTable" class="table table-hover align-middle table-bordered mb-0">
          <thead class="table-secondary position-sticky top-0" style="z-index: 2;">
            <tr>
              <th>#</th>
              <th>Date</th>
              <th>Type de matière</th>
              <th>Type de mouvement</th>
              <th>Quantité totale</th>
              <th>Montant total (F)</th>
            </tr>
          </thead>
          <tbody>
            <% mvtMatieres.forEach((grp, index) => { %>
              <tr>
                <th scope="row"><%= index + 1 %></th>
                <td><%= grp.date_mvt %></td>
                <td><%= grp.type_matiere %></td>
                <td><%= grp.type_mvt %></td>
                <td><%= new Intl.NumberFormat('fr-FR').format(grp.quantite) %></td>
                <td><%= new Intl.NumberFormat('fr-FR').format(grp.montant_total) %> FCFA</td>
              </tr>

            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="alert alert-secondary mt-2 mb-0">
        SACHET (ACHAT) <%= sachetAchat.totalQuantite %> <br>
        SACHET (UTILISATION) <%= sachetUtilisation.totalQuantite %> <br>
        SACHET (REBUS) <%= sachetRebus.totalQuantite %> <br>
        EMBALLAGE (ACHAT) <%= emballageAchat.totalQuantite %> <br>
        EMBALLAGE (UTILISATION) <%= emballageUtilisation.totalQuantite %> <br>
        EMBALLAGE (REBUS) <%= emballageRebus.totalQuantite %>
      </div>

    <% } else { %>
      <div class="alert alert-info">Aucun mouvement trouvé pour ce filtre.</div>
    <% } %>
  </div>
</div>

<!-- ======== SCRIPTS ======== -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  // Validation Bootstrap
  (function () {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  })();

  // Impression
  function imprimerMouvements() {
    const contenu = document.getElementById("mvtTable").outerHTML;
    const date = new Date().toLocaleDateString('fr-FR');
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
      <html>
        <head>
          <title>Mouvements de matières filtrés - BAMTI</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 30px; color: #333; }
            table { width: 100%; border-collapse: collapse; margin-top: 20px; }
            th, td { border: 1px solid #dee2e6; padding: 8px; text-align: center; }
            th { background-color: #f8f9fa; }
            tr:nth-child(even) { background-color: #f9f9f9; }
            @media print { button { display: none; } }
          </style>
        </head>
        <body>
          <h2>Mouvements de matières filtrés</h2>
          <p>Date : ${date}</p>
          ${contenu}
        </body>
      </html>
    `);
    printWindow.document.close();
    printWindow.print();
  }
</script>

<%- include('../partials/footer') %>

<!-- DataTables Buttons (export Copier / Excel / PDF) — chargé après le footer
     pour que jQuery et DataTables (déjà inclus par le footer) soient prêts. -->
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.bootstrap5.min.css">
<script src="https://cdn.datatables.net/buttons/3.2.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script>
  if (document.getElementById('mvtTable')) {
    const dtMvt = $('#mvtTable').DataTable({
      dom: 't',
      paging: false,
      searching: false,
      info: false,
      ordering: true,
    });
    new $.fn.dataTable.Buttons(dtMvt, {
      buttons: [
        { extend: 'copyHtml5', text: '<i class="bi bi-clipboard"></i> Copier', className: 'btn btn-sm btn-outline-secondary' },
        { extend: 'excelHtml5', text: '<i class="bi bi-file-earmark-excel"></i> Excel', className: 'btn btn-sm btn-outline-success' },
        { extend: 'pdfHtml5', text: '<i class="bi bi-file-earmark-pdf"></i> PDF', className: 'btn btn-sm btn-outline-danger' },
      ],
    });
    dtMvt.buttons().container().appendTo('#exportButtonsMvt');
  }
</script>
