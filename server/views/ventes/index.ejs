  <!-- Liste des ventes -->
 <div id="venteListContainer" class="mt-4">
<h5 class="mb-3 fw-bold">Liste des ventes</h5>
   <div class="d-flex justify-content-end mt-3">
    <!--  <button class="btn btn-secondary" onclick="imprimerToutesLesVentes()">
        <i class="bi bi-printer"></i> Imprimer toutes les ventes
      </button> -->
    </div>
  
  <% if (ventes && ventes.length > 0) { %>

    <!--  Conteneur scrollable propre -->
   <div class="table-responsive shadow-sm rounded"
     style="border: 1px solid #dee2e6;">
  <table id="dtable" class="table table-hover align-middle table-bordered mb-0">
    <thead class="table-secondary position-sticky top-0" >
      <tr>

        <th>X</th>
        <th>#</th>
        <th>Client</th>
        <th>Type vente</th>
        <th>Quantité</th>
        <th>Prix unitaire</th>
        <th>Montant total</th>
        <th>Type paiement</th>
        <th>Montant payé</th>
        <th>Reste à payer</th>
        <th>Date</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% ventes.forEach((vente, index) => { %>
        <tr id="vente-<%= vente.id %>" >
        <th scope="row">
          <button class="btn btn-danger btn-sm"
            data-id="<%= vente.id %>"
            data-client="<%= vente.Client ? vente.Client.nom + ' ' + (vente.Client.prenom || '') : '' %>"
            onclick="ouvrirModalAnnulation(this)">
            <i class="bi bi-x-circle me-1"></i>Annuler
          </button>
        </th>
          <th scope="row"><%= index + 1 %></th>
          <td><%= vente.Client ? vente.Client.nom + ' ' + (vente.Client.prenom || '') : '-' %></td>
          <td><%= vente.type_vente %></td>
          <td><%= vente.quantite %></td>
          <td><%= new Intl.NumberFormat('fr-FR').format(vente.prix_unitaire.toFixed(2)) %> FCFA</td>
          <td><%= new Intl.NumberFormat('fr-FR').format(vente.montantTotal.toFixed(2)) %> FCFA</td>
          <td>
            <span class="badge <%= vente.type_paiement === 'echellonner' ? 'bg-warning text-dark' : 'bg-success' %>">
              <%= vente.type_paiement %>
            </span>
          </td>
          <td><%= new Intl.NumberFormat('fr-FR').format(vente.montantPayes.toFixed(2)) %> FCFA</td>
          <td><%= new Intl.NumberFormat('fr-FR').format(vente.reste.toFixed(2)) %> FCFA</td>
          <td><%= new Date(vente.date_vente).toLocaleDateString('fr-FR') %></td>
          <td class="text-end">
            <% if (vente.type_paiement === 'echellonner') { %>
              <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                  Actions
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <% if (vente.reste > 0) { %>
                    <li>
                      <button type="button" class="dropdown-item" onclick="openVersementModal(<%= vente.id %>)">
                        <i class="bi bi-cash"></i> Faire un versement
                      </button>
                    </li>
                  <% } %>
                  <li>
                    <a class="dropdown-item" href="/ventes/versements/<%= vente.id_client %>">
                      <i class="bi bi-info-circle"></i> Détails
                    </a>
                  </li>
                  <li>
                        <button type="button" class="dropdown-item" onclick="imprimerVente(<%= vente.id %>)">
                          <i class="bi bi-printer"></i> Imprimer
                        </button>
                      </li>
                </ul>
              </div>
            <% } else { %>
                <button  class="btn btn-secondary " onclick="imprimerVente(<%= vente.id %>)">
                <i class="bi bi-printer"></i> print
                </button>
                      
            <% } %>
           
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
	   <br /><br /><br /><br /><br /><br /><br /><br /><br /><br />
</div>


  <% } else { %>
    <div class="alert alert-info">Aucune vente enregistrée.</div>
  <% } %>
</div>

</div>

<!-- Modal Versement -->

<div class="modal fade" id="versementModal" tabindex="-1" aria-labelledby="versementModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="versementForm" action="/ventes/ajouterVersement" method="POST">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="versementModalLabel">Faire un versement</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="id_vente" name="id_vente">

          <div class="mb-3">
            <label for="montant_versement" class="form-label">Montant du versement</label>
            <input type="number" step="0.01" min="0" class="form-control" id="montant_versement" name="montant" required>
          </div>

          <div class="mb-3">
            <label for="date_versement" class="form-label">Date du versement</label>
            <input type="date" class="form-control" id="date_versement" name="date" required>
          </div>

          <!--  Champ Observation ajouté ici -->
          <div class="mb-3">
            <label for="observation" class="form-label">Observation (optionnelle)</label>
            <textarea
              class="form-control"
              id="observation"
              name="observation"
              rows="3"
              placeholder="Ex : Paiement partiel, acompte, remise, etc."></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Enregistrer
          </button>
          <a href="/ventes/index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Retour
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>
  (function () {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        } else if (form.id === 'venteForm') {
          document.getElementById('loadingOverlay').style.display = 'flex';
        }
        form.classList.add('was-validated');
      }, false);
    });
  })();

  const modalVersement = new bootstrap.Modal(document.getElementById('versementModal'));

  // Montant temps réel
  function majMontant() {
    const qte = parseFloat(document.getElementById('quantite').value) || 0;
    const pu  = parseFloat(document.getElementById('prix_unitaire').value) || 0;
    document.getElementById('montantPreview').textContent =
      new Intl.NumberFormat('fr-FR').format(qte * pu) + ' FCFA';
  }
  document.getElementById('quantite').addEventListener('input', majMontant);
  document.getElementById('prix_unitaire').addEventListener('input', majMontant);
  majMontant();

  function openVersementModal(idVente) {
 const modalElement = document.getElementById('versementModal');
        if (modalElement) {
            const modalVersement = new bootstrap.Modal(modalElement);
            document.getElementById('id_vente').value = idVente;
            document.getElementById('montant_versement').value = '';
            document.getElementById('date_versement').value = new Date().toISOString().split('T')[0];
            modalVersement.show();
        }
    
   
  }
</script>


