<%- include('../partials/header') %>

<!-- Overlay de chargement -->
<div id="loadingOverlay" style="display:none; position:fixed; inset:0; background:rgba(255,255,255,0.75); z-index:2000; align-items:center; justify-content:center; flex-direction:column;">
  <div class="spinner-border text-primary" style="width:3.5rem;height:3.5rem;" role="status"></div>
  <div class="mt-3 fw-semibold text-primary">Enregistrement en cours...</div>
</div>

<div class="container-fluid no-margin-top">

  <% if (message) { %>
    <div id="myAlert" class="alert alert-<%= message.type %> alert-dismissible fade show mt-2" role="alert">
      <%= message.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="card shadow mt-3" style="border:none;border-radius:14px;overflow:hidden;">
    <div class="card-header py-3 text-white" style="background:linear-gradient(135deg,#1e3a5f 0%,#0ea5c9 100%);">
      <h4 class="mb-0 text-center"><i class="bi bi-cart-plus me-2"></i>Gestion des ventes</h4>
    </div>

    <div class="card-body" style="background:#f8fafc;">
      <!-- Formulaire création / modification -->
      <form id="venteForm" action="/ventes/createOrUpdate" method="POST" class="row g-3 align-items-end needs-validation" novalidate>
        <input type="hidden" name="id" id="venteId" value="">

        <div id="formStatus" class="col-12"></div>

        <!-- Sélection du client -->
        <div class="col-md-3">
          <label for="id_client" class="form-label fw-semibold"><i class="bi bi-person-fill me-1 text-primary"></i>Client</label>
          <select class="form-select select2-client" id="id_client" name="id_client" required>
            <option value="">-- Choisir un client --</option>
            <% clients.forEach(client => { %>
              <option value="<%= client.id %>"><%= client.nom %> <%= client.prenom || '' %></option>
            <% }) %>
          </select>
          <div class="invalid-feedback">Veuillez sélectionner un client.</div>
        </div>

        <div class="col-md-2">
          <label for="type_vente" class="form-label fw-semibold"><i class="bi bi-tag-fill me-1 text-primary"></i>Type de vente</label>
          <select class="form-select" id="type_vente" name="type_vente" required>
            <option value="">-- Choisir --</option>
            <option value="livrer">Livrée</option>
            <option value="usine">Usine</option>
          </select>
          <div class="invalid-feedback">Veuillez choisir le type de vente.</div>
        </div>

        <div class="col-md-1">
          <label for="quantite" class="form-label fw-semibold"><i class="bi bi-stack me-1 text-primary"></i>Qté</label>
          <input type="number" min="1" class="form-control" id="quantite" name="quantite" required>
          <div class="invalid-feedback">Requis.</div>
        </div>

        <div class="col-md-2">
          <label for="prix_unitaire" class="form-label fw-semibold"><i class="bi bi-cash-coin me-1 text-primary"></i>Prix unitaire</label>
          <div class="input-group">
            <input type="number" step="0.01" min="0" value="350" class="form-control" id="prix_unitaire" name="prix_unitaire" required>
            <span class="input-group-text text-muted small">FCFA</span>
          </div>
          <div class="invalid-feedback">Obligatoire.</div>
        </div>

        <div class="col-md-2 d-flex align-items-end">
          <div class="w-100 rounded-3 text-center py-2 px-3" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #86efac;">
            <div class="text-muted small mb-1"><i class="bi bi-calculator me-1"></i>Montant total</div>
            <div id="montantPreview" class="fw-bold fs-5 text-success">0 FCFA</div>
          </div>
        </div>

        <div class="col-md-2">
          <label for="type_paiement" class="form-label fw-semibold"><i class="bi bi-credit-card-fill me-1 text-primary"></i>Paiement</label>
          <select class="form-select" id="type_paiement" name="type_paiement" required>
            <option value="">-- Choisir --</option>
            <option value="total">Total</option>
            <option value="echellonner">Échelonner</option>
          </select>
          <div class="invalid-feedback">Requis.</div>
        </div>

        <div class="col-md-2">
          <label for="date_vente" class="form-label fw-semibold"><i class="bi bi-calendar-date-fill me-1 text-primary"></i>Date vente</label>
          <input type="date" class="form-control" id="date_vente" name="date_vente" required>
          <div class="invalid-feedback">Obligatoire.</div>
        </div>

        <div class="col-md-12 d-flex justify-content-end gap-2 mt-1">
          <button type="submit" id="submitBtn" class="btn btn-success px-4">
            <i class="bi bi-plus-circle me-1"></i><span id="submitText">Ajouter</span>
          </button>
          <a href="/ventes/filtre" class="btn btn-outline-secondary px-4">
            <i class="bi bi-funnel me-1"></i>Filtrer
          </a>
        </div>
      </form>
    </div>
  </div>
