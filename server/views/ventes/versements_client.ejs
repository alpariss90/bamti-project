<%- include('../partials/header', { pageTitle: pageTitle }) %>

<%
  const fmt = (n) => new Intl.NumberFormat('fr-FR').format(parseFloat(n) || 0);
  const fmtDate = (d) => new Date(d).toLocaleDateString('fr-FR');

  // Pré-calcul global
  let grandTotalVentes = 0;
  let grandTotalPaye   = 0;

  const ventesAvecCalc = ventes.map(v => {
    const montantTotal = v.quantite * v.prix_unitaire;
    const totalPaye    = (v.Paiements || []).reduce((s, p) => s + parseFloat(p.montant), 0);
    const reste        = montantTotal - totalPaye;
    const soldee       = reste <= 0.01;
    const pct          = montantTotal > 0 ? Math.min(100, Math.round((totalPaye / montantTotal) * 100)) : 0;
    grandTotalVentes  += montantTotal;
    grandTotalPaye    += totalPaye;
    return { v, montantTotal, totalPaye, reste, soldee, pct };
  });

  const grandReste   = grandTotalVentes - grandTotalPaye;
  const grandPct     = grandTotalVentes > 0 ? Math.min(100, Math.round((grandTotalPaye / grandTotalVentes) * 100)) : 0;
  const nonSoldees   = ventesAvecCalc.filter(x => !x.soldee);
  const soldees      = ventesAvecCalc.filter(x => x.soldee);
%>

<div class="container-fluid" id="venteTable">

  <!-- ── En-tête client + actions ─────────────────────────────────────────── -->
  <div class="card shadow-sm mt-3 mb-4 border-0">
    <div class="card-body text-dark rounded" style="background:#f8f9fa;border:1px solid #dee2e6">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h4 class="mb-1 fw-bold"><i class="bi bi-person-circle me-2"></i><%= cl.nom %> <%= cl.prenom %></h4>
          <span class="opacity-75 small"><%= ventes.length %> vente(s) &bull; <%= nonSoldees.length %> non soldée(s)</span>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-secondary btn-sm" onclick="imprimerToutesLesVentes()">
            <i class="bi bi-printer me-1"></i>Imprimer
          </button>
          <a href="/ventes/redevable" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour
          </a>
        </div>
      </div>

      <!-- Résumé global -->
      <div class="row g-2 mt-3">
        <div class="col-4">
          <div class="border rounded p-2 text-center bg-white">
            <div class="small text-muted">Total ventes</div>
            <div class="fw-bold fs-6"><%= fmt(grandTotalVentes) %> F</div>
          </div>
        </div>
        <div class="col-4">
          <div class="border border-success rounded p-2 text-center bg-white">
            <div class="small text-success">Total payé</div>
            <div class="fw-bold fs-6 text-success"><%= fmt(grandTotalPaye) %> F</div>
          </div>
        </div>
        <div class="col-4">
          <div class="border border-danger rounded p-2 text-center bg-white">
            <div class="small text-danger">Reste à payer</div>
            <div class="fw-bold fs-6 text-danger"><%= fmt(grandReste) %> F</div>
          </div>
        </div>
      </div>
      <div class="mt-2">
        <div class="progress" style="height:8px">
          <div class="progress-bar bg-success" style="width:<%= grandPct %>%"></div>
        </div>
        <div class="text-end small text-muted mt-1"><%= grandPct %>% payé</div>
      </div>
    </div>
  </div>

  <% if (ventes.length === 0) { %>
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Aucune vente trouvée pour ce client.</div>
  <% } else { %>

    <!-- ── Ventes NON soldées ───────────────────────────────────────────────── -->
    <% if (nonSoldees.length > 0) { %>
      <div class="d-flex align-items-center gap-2 mb-3">
        <span class="badge bg-danger fs-6 px-3 py-2">
          <i class="bi bi-exclamation-circle me-1"></i><%= nonSoldees.length %> non soldée(s)
        </span>
        <hr class="flex-grow-1 border-danger opacity-50">
      </div>

      <% nonSoldees.forEach(({ v, montantTotal, totalPaye, reste, pct }, i) => { %>
        <div class="card shadow-sm mb-3 border-danger border-opacity-50">
          <!-- En-tête vente -->
          <div class="card-header d-flex flex-wrap justify-content-between align-items-start gap-2 bg-danger bg-opacity-10">
            <div>
              <span class="fw-bold text-danger">#<%= v.id %></span>
              <% if (v.date_vente) { %>
                <span class="text-muted ms-2 small"><i class="bi bi-calendar3 me-1"></i><%= fmtDate(v.date_vente) %></span>
              <% } %>
              <span class="badge bg-secondary ms-2"><%= v.type_paiement %></span>
              <% if (v.observation && v.observation !== 'reservation') { %>
                <span class="text-muted small ms-2 fst-italic"><%= v.observation %></span>
              <% } %>
            </div>
            <span class="badge bg-danger"><i class="bi bi-clock me-1"></i>Non soldée</span>
          </div>

          <div class="card-body pb-2">
            <!-- Métriques -->
            <div class="row g-2 mb-3">
              <div class="col-4 text-center">
                <div class="small text-muted">Qté × PU</div>
                <div class="fw-semibold"><%= v.quantite %> × <%= fmt(v.prix_unitaire) %> F</div>
              </div>
              <div class="col-4 text-center">
                <div class="small text-muted">Total</div>
                <div class="fw-bold text-dark"><%= fmt(montantTotal) %> F</div>
              </div>
              <div class="col-4 text-center">
                <div class="small text-muted">Reste</div>
                <div class="fw-bold text-danger"><%= fmt(reste) %> F</div>
              </div>
            </div>

            <!-- Barre de progression -->
            <div class="progress mb-1" style="height:10px">
              <div class="progress-bar bg-danger" style="width:<%= pct %>%"></div>
            </div>
            <div class="d-flex justify-content-between small text-muted mb-3">
              <span>Payé : <strong class="text-success"><%= fmt(totalPaye) %> F</strong></span>
              <span><%= pct %>%</span>
            </div>

            <!-- Tableau des versements -->
            <% if (!v.Paiements || v.Paiements.length === 0) { %>
              <div class="alert alert-warning py-2 mb-0">
                <i class="bi bi-exclamation-triangle me-1"></i>Aucun versement effectué.
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered mb-0">
                  <thead class="table-danger">
                    <tr>
                      <th>#</th><th>Date</th><th>Montant (F)</th><th>Observation</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% v.Paiements.forEach((p, j) => { %>
                      <tr>
                        <td class="text-muted"><%= j+1 %></td>
                        <td><%= fmtDate(p.date) %></td>
                        <td class="fw-semibold text-success"><%= fmt(p.montant) %></td>
                        <td class="text-muted fst-italic"><%= p.observation || '—' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                  <tfoot class="table-light fw-semibold">
                    <tr>
                      <td colspan="2" class="text-end">Sous-total payé</td>
                      <td class="text-success"><%= fmt(totalPaye) %> F</td>
                      <td></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- ── Ventes soldées ──────────────────────────────────────────────────── -->
    <% if (soldees.length > 0) { %>
      <div class="d-flex align-items-center gap-2 mb-3 mt-4">
        <span class="badge bg-success fs-6 px-3 py-2">
          <i class="bi bi-check-circle me-1"></i><%= soldees.length %> soldée(s)
        </span>
        <hr class="flex-grow-1 border-success opacity-50">
      </div>

      <% soldees.forEach(({ v, montantTotal, totalPaye, pct }, i) => { %>
        <div class="card shadow-sm mb-3 border-success border-opacity-25">
          <!-- En-tête vente -->
          <div class="card-header d-flex flex-wrap justify-content-between align-items-start gap-2 bg-success bg-opacity-10">
            <div>
              <span class="fw-bold text-success">#<%= v.id %></span>
              <% if (v.date_vente) { %>
                <span class="text-muted ms-2 small"><i class="bi bi-calendar3 me-1"></i><%= fmtDate(v.date_vente) %></span>
              <% } %>
              <span class="badge bg-secondary ms-2"><%= v.type_paiement %></span>
            </div>
            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Soldée</span>
          </div>

          <div class="card-body pb-2">
            <div class="row g-2 mb-2">
              <div class="col-4 text-center">
                <div class="small text-muted">Qté × PU</div>
                <div class="fw-semibold"><%= v.quantite %> × <%= fmt(v.prix_unitaire) %> F</div>
              </div>
              <div class="col-4 text-center">
                <div class="small text-muted">Total</div>
                <div class="fw-bold"><%= fmt(montantTotal) %> F</div>
              </div>
              <div class="col-4 text-center">
                <div class="small text-muted">Payé</div>
                <div class="fw-bold text-success"><%= fmt(totalPaye) %> F</div>
              </div>
            </div>
            <div class="progress mb-3" style="height:8px">
              <div class="progress-bar bg-success" style="width:100%"></div>
            </div>

            <% if (!v.Paiements || v.Paiements.length === 0) { %>
              <p class="text-muted small mb-0">Aucun versement enregistré.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered mb-0">
                  <thead class="table-success">
                    <tr>
                      <th>#</th><th>Date</th><th>Montant (F)</th><th>Observation</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% v.Paiements.forEach((p, j) => { %>
                      <tr>
                        <td class="text-muted"><%= j+1 %></td>
                        <td><%= fmtDate(p.date) %></td>
                        <td class="fw-semibold text-success"><%= fmt(p.montant) %></td>
                        <td class="text-muted fst-italic"><%= p.observation || '—' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- ── Bilan global ───────────────────────────────────────────────────── -->
    <div class="card shadow border-0 mt-4 mb-4">
      <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-calculator me-2"></i>Bilan global — <%= cl.nom %> <%= cl.prenom %>
      </div>
      <div class="card-body">
        <div class="row g-3 text-center">
          <div class="col-md-3 col-6">
            <div class="border rounded p-3">
              <div class="text-muted small">Nb ventes</div>
              <div class="fw-bold fs-5"><%= ventes.length %></div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="border rounded p-3">
              <div class="text-muted small">Total dû</div>
              <div class="fw-bold fs-5"><%= fmt(grandTotalVentes) %> F</div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="border rounded p-3 border-success">
              <div class="text-success small">Total payé</div>
              <div class="fw-bold fs-5 text-success"><%= fmt(grandTotalPaye) %> F</div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="border rounded p-3 border-danger">
              <div class="text-danger small">Reste à payer</div>
              <div class="fw-bold fs-5 text-danger"><%= fmt(grandReste) %> F</div>
            </div>
          </div>
        </div>
        <div class="mt-3">
          <div class="progress" style="height:14px">
            <div class="progress-bar bg-success" style="width:<%= grandPct %>%">
              <% if (grandPct > 10) { %><%= grandPct %>%<% } %>
            </div>
          </div>
          <div class="text-muted small text-end mt-1"><%= grandPct %>% du total payé</div>
        </div>
      </div>
    </div>

  <% } %>
</div>

<script>
function imprimerToutesLesVentes() {
  const contenu = document.getElementById('venteTable').innerHTML;
  const date = new Date().toLocaleDateString('fr-FR');
  const w = window.open('', '_blank');
  w.document.write(`
    <html><head><title>Détail versements - <%= cl.nom %> <%= cl.prenom %></title>
    <style>
      body{font-family:'Segoe UI',Arial,sans-serif;margin:30px;color:#333}
      .entete{text-align:center;border-bottom:2px solid #6c757d;padding-bottom:12px;margin-bottom:20px}
      .entete h2{color:#6c757d;font-weight:700;margin:0}
      table{width:100%;border-collapse:collapse;font-size:12px;margin-top:8px}
      th,td{border:1px solid #dee2e6;padding:7px;text-align:left}
      th{background:#f8f9fa;font-weight:600}
      tr:nth-child(even){background:#f9f9f9}
      .card{border:1px solid #dee2e6;border-radius:6px;margin-bottom:16px;page-break-inside:avoid}
      .card-header{padding:10px 14px;font-weight:600;background:#f8f9fa}
      .card-body{padding:12px 14px}
      .badge{padding:3px 8px;border-radius:4px;font-size:11px}
      .bg-danger{background:#dc3545;color:#fff}
      .bg-success{background:#28a745;color:#fff}
      .bg-secondary{background:#6c757d;color:#fff}
      .bilan{border:2px solid #343a40;border-radius:6px;padding:14px;margin-top:20px}
      button{display:none}
      .progress{display:none}
      footer{text-align:center;margin-top:30px;font-size:12px;color:#888;border-top:1px solid #ccc;padding-top:8px}
    </style></head><body>
    <div class="entete">
      <h2>Entreprise BAMTI</h2>
      <p style="margin:4px 0;color:#555">NIF: 64750/P | SONUCI KOUBIA | Tél : 99582158 / 90231123</p>
      <small>Édité le : ${date}</small>
    </div>
    <h4 style="text-align:center;margin-bottom:20px">Détail des versements — <%= cl.nom %> <%= cl.prenom %></h4>
    ${contenu}
    <footer>Merci pour votre confiance — © Entreprise BAMTI</footer>
    </body></html>`);
  w.document.close();
  w.print();
}
</script>

<%- include('../partials/footer') %>
