<%- include('../partials/header') %>

<div class="container-fluid no-margin-top">

  <% if (message) { %>
    <div id="myAlert" class="alert alert-<%= message.type %> alert-dismissible fade show mt-2" role="alert">
      <%= message.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="card shadow-sm mt-3">
    <div class="card-header bg-secondary text-white">
      <h4 class="mb-0 text-center">Filtrer les ventes </h4>
    </div>

    <div class="card-body">
      <!-- Formulaire de filtre -->
      <form id="filtreForm" action="/ventes/filtre" method="GET" class="row g-2 align-items-end needs-validation" novalidate>
  <div class="col-md-2">
    <label for="id_client" class="form-label">Client</label>
    <select class="form-select" id="id_client" name="id_client" required>
      <option value="">-- Choisir un client --</option>
      <option value="tous" <%= id_client === 'tous' ? 'selected' : '' %>>Tous les clients</option>
      <% clients.forEach(client => { %>
        <option value="<%= client.id %>" <%= id_client == client.id ? 'selected' : '' %>>
          <%= client.nom %> <%= client.prenom || '' %>
        </option>
      <% }) %>
    </select>
    <div class="invalid-feedback">Veuillez sélectionner un client.</div>
  </div>

  <div class="col-md-2">
    <label for="id_client" class="form-label">Caissier</label>
    <select class="form-select" id="id_user" name="id_user" required>
      <option value="">-- Choisir un caissier --</option>
      <option value="tous" <%= id_user === 'tous' ? 'selected' : '' %>>Tous les utilisateurs</option>
      <% users.forEach(user => { %>
        <option value="<%= user.id %>" <%= id_user == user.id ? 'selected' : '' %>>
          <%= user.login %> || <%= user.nom || '' %>
        </option>
      <% }) %>
    </select>
    <div class="invalid-feedback">Veuillez sélectionner un client.</div>
  </div>

  <div class="col-md-2">
    <label for="type_vente" class="form-label">Type de vente</label>
    <select class="form-select" id="type_vente" name="type_vente" required>
      <option value="">-- Choisir --</option>
      <option value="tous" <%= type_vente === 'tous' ? 'selected' : '' %>>Tous les types</option>
      <option value="livrer" <%= type_vente === 'livrer' ? 'selected' : '' %>>Livrée</option>
      <option value="usine" <%= type_vente === 'usine' ? 'selected' : '' %>>Usine</option>
    </select>
    <div class="invalid-feedback">Veuillez choisir le type de vente.</div>
  </div>

  <div class="col-md-2">
    <label for="date_debut" class="form-label">Date début</label>
    <input type="date" class="form-control" id="date_debut" name="date_debut"  value="<%= date_debut || '' %>" required>
    <div class="invalid-feedback">Date début obligatoire.</div>
  </div>

  <div class="col-md-2">
    <label for="date_fin" class="form-label">Date fin</label>
    <input type="date" class="form-control" id="date_fin" name="date_fin"  value="<%= date_fin || '' %>" required>
    <div class="invalid-feedback">Date fin obligatoire.</div>
  </div>

  <div class="col-md-2 d-flex justify-content-end gap-2 mt-2">
    <button type="submit" class="btn btn-primary">
      <i class="bi bi-funnel"></i> Filtrer
    </button>
    <a href="/ventes/index" class="btn btn-secondary">
      <i class="bi bi-arrow-left-circle"></i> Retour
    </a>
  </div>
</form>

    </div>
  </div>

  <!-- Liste des ventes filtrées -->
  <div id="venteListContainer" class="mt-4">
    <h5 class="mb-3 fw-bold">Ventes filtrées</h5>

    <% if (ventes && ventes.length > 0) { %>
      <div class="d-flex justify-content-end mb-2">
        <button class="btn btn-secondary" onclick="imprimerToutesLesVentes()">
          <i class="bi bi-printer"></i> Imprimer les ventes
        </button>
      </div>

      <div class="table-responsive shadow-sm rounded" style="height: 70vh; overflow-y: scroll; border: 1px solid #dee2e6;">
        <table id="venteTable" class="table table-hover align-middle table-bordered mb-0">
          <thead class="table-secondary position-sticky top-0" style="z-index: 2;">
            <tr>
              <th>#</th>
              <th>Client</th>
              <th>Type vente</th>
              <th>Quantité totale</th>
              <th>Montant total</th>
              <th>Montant payé</th>
              <th>Reste à payer</th>
            </tr>
          </thead>
          <tbody>
            <% ventes.forEach((vente, index) => { %>
              <tr>
                <th scope="row"><%= index + 1 %></th>
                <td><%= vente.client ? vente.client.nom + ' ' + (vente.client.prenom || '') : '-' %></td>
                <td><%= vente.type_ventes %></td>
                <td><%= vente.quantite %></td>
                <td><%= vente.montantTotal.toFixed(2) %> F</td>
                <td><%= vente.montantPayes.toFixed(2) %> F</td>
                <td><%= vente.reste.toFixed(2) %> F</td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot class="table-secondary fw-bold">
            <tr>
              <td colspan="3" class="text-center">Totaux généraux</td>
              <td><%= ventes.reduce((sum, v) => sum + v.quantite, 0) %></td>
              <td><%= ventes.reduce((sum, v) => sum + v.montantTotal, 0).toFixed(2) %> F</td>
              <td><%= ventes.reduce((sum, v) => sum + v.montantPayes, 0).toFixed(2) %> F</td>
              <td><%= ventes.reduce((sum, v) => sum + v.reste, 0).toFixed(2) %> F</td>
            </tr>
          </tfoot>
        </table>
      </div>

    <% } else { %>
      <div class="alert alert-info">Aucune vente trouvée pour ce filtre.</div>
    <% } %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  (function () {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  })();

  function imprimerToutesLesVentes() {
    const contenu = document.getElementById("venteTable").outerHTML;
    const date = new Date().toLocaleDateString('fr-FR');
    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
      <html>
        <head>
          <title>Ventes filtrées - BAMTI</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 30px; color: #333; }
            table { width: 100%; border-collapse: collapse; margin-top: 20px; }
            th, td { border: 1px solid #dee2e6; padding: 8px; text-align: center; }
            th { background-color: #f8f9fa; }
            tr:nth-child(even) { background-color: #f9f9f9; }
            @media print { button { display: none; } }
          </style>
        </head>
        <body>
          <h2>Ventes filtrées</h2>
          <p>Date : ${date}</p>
          ${contenu}
        </body>
      </html>
    `);
    printWindow.document.close();
    printWindow.print();
  }
</script>

<%- include('../partials/footer') %>
